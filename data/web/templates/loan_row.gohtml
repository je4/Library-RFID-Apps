<tr id="loan-tag-{{.ID}}" class="tag-row app-tag-row border-b transition-colors animate-scan-flash group" data-itemid="{{.ItemID}}" data-uid="{{.UID}}">
    <!-- Item ID -->
    <td class="py-3.5 px-4 font-mono font-medium">
        <div class="flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full {{if .CRCOk}}bg-emerald-500{{else}}bg-rose-500{{end}}"></span>
            {{if .ItemID}}
            <div class="inline-flex items-center space-x-1.5">
                <span class="text-sm font-semibold tracking-wide app-tag-item-id loan-item-id">{{.ItemID}}</span>
                <button type="button" class="copy-itemid-btn app-copy-btn p-0.5 rounded transition-colors" data-itemid="{{.ItemID}}" title="ItemID in Zwischenablage kopieren">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                </button>
            </div>
            {{else}}
            <span class="text-sm font-semibold tracking-wide app-tag-item-id"><span class="app-text-dim italic">Keine ItemID</span></span>
            {{end}}
        </div>
    </td>

    <!-- UID with Copy Button -->
    <td class="py-3.5 px-4 font-mono text-xs">
        <div class="inline-flex items-center space-x-1.5 app-uid-box px-2 py-1 rounded transition-colors">
            <span>{{.UID}}</span>
            <button type="button" class="copy-uid-btn app-copy-btn p-0.5 rounded transition-colors" data-uid="{{.UID}}" title="UID in Zwischenablage kopieren">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
            </button>
        </div>
    </td>

    <!-- Parts (Multi-Part indicator) -->
    <td class="py-3.5 px-4 text-xs font-mono">
        {{if .IsMultiPart}}
        Teil {{.PartNo}} / {{.Parts}}
        {{else}}
        Einzelmedium (1/1)
        {{end}}
    </td>

    <!-- ISIL & Country -->
    <td class="py-3.5 px-4 text-xs font-mono">
        {{if or .ISIL .Country}}
        <div class="flex items-center space-x-1">
            <span>{{if .Country}}{{.Country}}-{{end}}{{if .ISIL}}{{.ISIL}}{{end}}</span>
        </div>
        {{else}}
        <span class="app-text-dim">-</span>
        {{end}}
    </td>

    <!-- CRC Check Status -->
    <td class="py-3.5 px-4 text-xs font-mono">
        {{if .CRCOk}}
        <span class="inline-flex items-center space-x-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>OK (Gültig)</span>
        </span>
        {{else}}
        <span class="inline-flex items-center space-x-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            <span>Fehler</span>
        </span>
        {{end}}
    </td>

    <!-- AFI / Security Status -->
    <td class="py-3.5 px-4 text-xs font-mono app-afi-status-cell">
        <div class="flex flex-col space-y-1">
            <div class="flex items-center space-x-1.5 flex-wrap gap-1">
                {{if .AFISecured}}
                <span class="inline-flex items-center space-x-1" title="AFI 07: Gesichert / Präsenzbestand / EAS aktiv">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                    <span>Gesichert (07)</span>
                </span>
                {{else if .AFIUnsecured}}
                <span class="inline-flex items-center space-x-1" title="AFI C2: Entsichert / Ausgeliehen / EAS deaktiviert">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path>
                    </svg>
                    <span>Entsichert (C2)</span>
                </span>
                {{else if .AFI}}
                <span>AFI: {{.AFI}}</span>
                {{else}}
                <span class="app-text-dim">-</span>
                {{end}}

                {{if eq .AFIWriteStatus "success"}}
                <span class="text-[11px] font-medium opacity-75" title="AFI erfolgreich geschrieben">(Erfolg)</span>
                {{else if eq .AFIWriteStatus "error"}}
                <span class="text-[11px] font-medium opacity-75" title="{{if .AFIWriteError}}{{.AFIWriteError}}{{else}}Fehler beim AFI-Schreiben{{end}}">(Fehler)</span>
                {{else if or (eq .AFIWriteStatus "pending") .AFIWritePending}}
                <span class="text-[11px] font-medium opacity-75 animate-pulse">(Schreiben...)</span>
                {{end}}
            </div>
            {{if and (eq .AFIWriteStatus "error") .AFIWriteError}}
            <div class="text-[11px] opacity-75 font-mono" title="{{.AFIWriteError}}">
                {{.AFIWriteError}}
            </div>
            {{end}}
        </div>
    </td>

    <!-- Individual Actions -->
    <td class="py-3.5 px-4 text-xs whitespace-nowrap">
        <div class="inline-flex items-center space-x-1.5">
            <button type="button"
                    hx-post="loan/afi/unsecure?uid={{.UID}}"
                    hx-target="#loan-table-body"
                    hx-swap="innerHTML"
                    class="px-2 py-1 text-[11px] font-medium rounded app-btn transition-colors inline-flex items-center space-x-1 cursor-pointer"
                    title="Diesen Transponder einzeln entsichern (C2)">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path>
                </svg>
                <span>Entsichern</span>
            </button>
            <button type="button"
                    hx-post="loan/afi/secure?uid={{.UID}}"
                    hx-target="#loan-table-body"
                    hx-swap="innerHTML"
                    class="px-2 py-1 text-[11px] font-medium rounded app-btn transition-colors inline-flex items-center space-x-1 cursor-pointer"
                    title="Diesen Transponder einzeln sichern (07)">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
                <span>Sichern</span>
            </button>
        </div>
    </td>

    <!-- Erfassungszeit -->
    <td class="py-3.5 px-4 text-xs text-right whitespace-nowrap">
        <div class="app-time-text font-mono">{{.TimeFormatted}}</div>
        <div class="text-[11px] app-time-ago time-ago" data-timestamp="{{.Timestamp}}">gerade eben</div>
    </td>
</tr>
