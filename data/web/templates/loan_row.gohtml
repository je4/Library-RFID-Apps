<tr id="loan-tag-{{.ID}}" class="tag-row app-tag-row border-b transition-colors animate-scan-flash group" data-itemid="{{.ItemID}}" data-uid="{{.UID}}">
    <!-- Item ID -->
    <td class="py-3.5 px-4 font-mono font-medium whitespace-nowrap">
        <div class="flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full flex-shrink-0 {{if .CRCOk}}bg-emerald-500{{else}}bg-rose-500{{end}}"></span>
            {{if .ItemID}}
            <div class="inline-flex items-center space-x-1.5 flex-nowrap">
                <span class="text-sm font-semibold tracking-wide app-tag-item-id loan-item-id">{{.ItemID}}</span>
                <button type="button" class="copy-itemid-btn app-copy-btn p-0.5 rounded transition-colors flex-shrink-0" data-itemid="{{.ItemID}}" title="ItemID in Zwischenablage kopieren">
                    <img src="{{.StaticPath}}/img/copy.svg" class="w-3.5 h-3.5 flex-shrink-0" width="14" height="14" alt="Kopieren" />
                </button>
            </div>
            {{else}}
            <span class="text-sm font-semibold tracking-wide app-tag-item-id"><span class="app-text-dim italic">Keine ItemID</span></span>
            {{end}}
        </div>
    </td>

    <!-- UID with Copy Button -->
    <td class="py-3.5 px-4 font-mono text-xs whitespace-nowrap">
        <div class="inline-flex items-center space-x-1.5 app-uid-box px-2 py-1 rounded transition-colors flex-nowrap">
            <span class="whitespace-nowrap">{{.UID}}</span>
            <button type="button" class="copy-uid-btn app-copy-btn p-0.5 rounded transition-colors flex-shrink-0" data-uid="{{.UID}}" title="UID in Zwischenablage kopieren">
                <img src="{{.StaticPath}}/img/copy.svg" class="w-3.5 h-3.5 flex-shrink-0" width="14" height="14" alt="Kopieren" />
            </button>
        </div>
    </td>

    <!-- Parts (Multi-Part indicator) -->
    <td class="py-3.5 px-4 text-xs font-mono">
        {{if .IsMultiPart}}
        Teil {{.PartNo}} / {{.Parts}}
        {{else}}
        Einzelmedium (1/1)
        {{end}}
    </td>

    <!-- ISIL & Country & Library Flyout -->
    <td class="py-3.5 px-4 text-xs">
        {{if or .ISIL .Country .ISILName}}
        <div class="app-isil-container">
            {{if .ISILName}}
            <span class="font-sans font-semibold text-xs tracking-tight app-isil-name break-words whitespace-normal block mb-0.5" title="{{.ISILName}}">{{.ISILName}}</span>
            {{end}}
            <div class="font-mono text-[11px] flex items-center space-x-1.5 {{if not .ISILName}}font-semibold text-xs{{else}}app-text-dim{{end}}">
                <span class="app-isil-code">{{if .Country}}{{.Country}}-{{end}}{{.ISIL}}</span>
                {{if .ISILEntry}}
                <div class="app-isil-info-wrapper relative inline-flex items-center">
                    <span class="app-isil-info-btn inline-flex items-center justify-center p-0.5 rounded cursor-pointer text-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors" title="Bibliotheksdetails anzeigen (Mouseover)">
                        <img src="{{.StaticPath}}/img/info-circle.svg" class="w-3.5 h-3.5 flex-shrink-0" alt="Info" />
                    </span>

                    <!-- Detailed Library Flyout Template -->
                    <template class="app-isil-flyout-template">
                        <div class="flex items-start justify-between gap-2 border-b pb-2 mb-2 app-flyout-header">
                            <div>
                                <h4 class="text-xs font-bold leading-tight font-sans app-flyout-title">{{.ISILEntry.NameOriginal}}</h4>
                                {{if and .ISILEntry.NameDE (ne .ISILEntry.NameDE .ISILEntry.NameOriginal)}}
                                <div class="text-[11px] app-text-dim font-sans mt-0.5">{{.ISILEntry.NameDE}}</div>
                                {{else if and .ISILEntry.NameFR (ne .ISILEntry.NameFR .ISILEntry.NameOriginal)}}
                                <div class="text-[11px] app-text-dim font-sans mt-0.5">{{.ISILEntry.NameFR}}</div>
                                {{else if and .ISILEntry.NameIT (ne .ISILEntry.NameIT .ISILEntry.NameOriginal)}}
                                <div class="text-[11px] app-text-dim font-sans mt-0.5">{{.ISILEntry.NameIT}}</div>
                                {{else if and .ISILEntry.NameEN (ne .ISILEntry.NameEN .ISILEntry.NameOriginal)}}
                                <div class="text-[11px] app-text-dim font-sans mt-0.5">{{.ISILEntry.NameEN}}</div>
                                {{end}}
                            </div>
                            <div class="flex flex-col items-end gap-1 flex-shrink-0">
                                <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-medium app-flyout-badge">{{.ISILEntry.ISIL}}</span>
                                {{if .ISILEntry.Status}}
                                <span class="inline-flex items-center gap-1 text-[10px] font-medium {{if eq .ISILEntry.Status "aktiv"}}text-emerald-600 dark:text-emerald-400{{else}}app-text-dim{{end}}">
                                    <span class="w-1.5 h-1.5 rounded-full {{if eq .ISILEntry.Status "aktiv"}}bg-emerald-500{{else}}bg-slate-400{{end}}"></span>
                                    {{.ISILEntry.Status}}
                                </span>
                                {{end}}
                            </div>
                        </div>

                        <div class="space-y-2 text-[11px] leading-relaxed font-sans">
                            {{if .ISILEntry.Mutterinstitution}}
                            <div>
                                <span class="app-flyout-label">Mutterinstitution:</span>
                                <span class="font-medium break-words">{{.ISILEntry.Mutterinstitution}}</span>
                            </div>
                            {{end}}

                            {{if or .ISILEntry.Institutionstyp .ISILEntry.Institutionskategorie .ISILEntry.VZSigel}}
                            <div class="flex flex-wrap gap-x-3 gap-y-1 text-[10px] app-text-dim">
                                {{if .ISILEntry.Institutionstyp}}<span>Typ: <strong class="app-flyout-val">{{.ISILEntry.Institutionstyp}}</strong></span>{{end}}
                                {{if .ISILEntry.Institutionskategorie}}<span>Kategorie: <strong class="app-flyout-val">{{.ISILEntry.Institutionskategorie}}</strong></span>{{end}}
                                {{if .ISILEntry.VZSigel}}<span>VZ-Sigel: <strong class="app-flyout-val font-mono">{{.ISILEntry.VZSigel}}</strong></span>{{end}}
                            </div>
                            {{end}}

                            <!-- Adresse -->
                            {{if or .ISILEntry.Strasse .ISILEntry.Ortschaft .ISILEntry.Postfach}}
                            <div class="pt-1 border-t border-slate-200/60 dark:border-slate-700/60">
                                <div class="app-flyout-label mb-0.5">Adresse:</div>
                                <div class="pl-2 border-l-2 border-blue-500/40 space-y-0.5">
                                    {{if .ISILEntry.Strasse}}<div>{{.ISILEntry.Strasse}}{{if .ISILEntry.Adresszusatz}}, {{.ISILEntry.Adresszusatz}}{{end}}</div>{{end}}
                                    {{if .ISILEntry.Postfach}}<div class="text-[10px] app-text-dim">Postfach: {{.ISILEntry.Postfach}}</div>{{end}}
                                    <div>{{.ISILEntry.Postleitzahl}} {{.ISILEntry.Ortschaft}}{{if .ISILEntry.Kanton}} ({{.ISILEntry.Kanton}}){{end}}</div>
                                    {{if .ISILEntry.Land}}<div class="text-[10px] app-text-dim">{{.ISILEntry.Land}}</div>{{end}}
                                </div>
                            </div>
                            {{end}}

                            <!-- Kontakt -->
                            {{if or .ISILEntry.Telefon .ISILEntry.EMail .ISILEntry.Webseite}}
                            <div class="pt-1 border-t border-slate-200/60 dark:border-slate-700/60 space-y-1">
                                {{if .ISILEntry.Telefon}}
                                <div class="flex items-center space-x-1.5">
                                    <span class="app-flyout-label w-12 flex-shrink-0">Telefon:</span>
                                    <a href="tel:{{.ISILEntry.Telefon}}" class="font-mono hover:text-blue-500 transition-colors">{{.ISILEntry.Telefon}}</a>
                                </div>
                                {{end}}
                                {{if .ISILEntry.EMail}}
                                <div class="flex items-center space-x-1.5">
                                    <span class="app-flyout-label w-12 flex-shrink-0">E-Mail:</span>
                                    <a href="mailto:{{.ISILEntry.EMail}}" class="text-blue-500 hover:underline break-all">{{.ISILEntry.EMail}}</a>
                                </div>
                                {{end}}
                                {{if .ISILEntry.Webseite}}
                                <div class="flex items-start space-x-1.5">
                                    <span class="app-flyout-label w-12 flex-shrink-0 mt-0.5">Web:</span>
                                    <a href="{{.ISILEntry.Webseite}}" target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline break-all inline-flex items-center gap-1">
                                        <span>{{.ISILEntry.Webseite}}</span>
                                        <img src="{{.StaticPath}}/img/external-link.svg" class="w-3 h-3 flex-shrink-0" alt="Web" />
                                    </a>
                                </div>
                                {{end}}
                            </div>
                            {{end}}

                            <!-- Fernleihe -->
                            {{if or .ISILEntry.FernleiheMail .ISILEntry.FernleiheTelefon .ISILEntry.FernleiheOrtschaft}}
                            <div class="pt-1 border-t border-slate-200/60 dark:border-slate-700/60">
                                <div class="app-flyout-label mb-0.5">Fernleihe:</div>
                                <div class="pl-2 border-l-2 border-indigo-500/40 space-y-0.5 text-[10px]">
                                    {{if .ISILEntry.FernleiheMail}}<div>Mail: <a href="mailto:{{.ISILEntry.FernleiheMail}}" class="text-blue-500 hover:underline break-all">{{.ISILEntry.FernleiheMail}}</a></div>{{end}}
                                    {{if .ISILEntry.FernleiheTelefon}}<div>Tel: <span class="font-mono">{{.ISILEntry.FernleiheTelefon}}</span></div>{{end}}
                                    {{if or .ISILEntry.FernleiheStrasse .ISILEntry.FernleiheOrtschaft}}
                                    <div>{{if .ISILEntry.FernleiheStrasse}}{{.ISILEntry.FernleiheStrasse}}, {{end}}{{.ISILEntry.FernleihePostleitzahl}} {{.ISILEntry.FernleiheOrtschaft}}</div>
                                    {{end}}
                                </div>
                            </div>
                            {{end}}

                            <!-- Bestand & Services -->
                            {{if or .ISILEntry.Bibliotheksbestand .ISILEntry.OnlineKatalog .ISILEntry.Zugangsbedingungen .ISILEntry.Zugaenglichkeitsgrad .ISILEntry.Mitgliedschaft}}
                            <div class="pt-1 border-t border-slate-200/60 dark:border-slate-700/60 space-y-1 text-[10px]">
                                {{if .ISILEntry.Bibliotheksbestand}}<div><span class="app-flyout-label">Bestand:</span> <span class="break-words">{{.ISILEntry.Bibliotheksbestand}}</span></div>{{end}}
                                {{if .ISILEntry.OnlineKatalog}}<div><span class="app-flyout-label">Katalog:</span> <a href="{{.ISILEntry.OnlineKatalog}}" target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline break-all">Online-Katalog öffnen</a></div>{{end}}
                                {{if .ISILEntry.Zugangsbedingungen}}<div><span class="app-flyout-label">Zugang:</span> <span class="break-words">{{.ISILEntry.Zugangsbedingungen}}</span></div>{{end}}
                                {{if .ISILEntry.Zugaenglichkeitsgrad}}<div><span class="app-flyout-label">Zugänglichkeit:</span> <span class="break-words">{{.ISILEntry.Zugaenglichkeitsgrad}}</span></div>{{end}}
                                {{if .ISILEntry.Mitgliedschaft}}<div><span class="app-flyout-label">Mitgliedschaft:</span> <span class="break-words">{{.ISILEntry.Mitgliedschaft}}</span></div>{{end}}
                            </div>
                            {{end}}
                        </div>
                    </template>
                </div>
                {{end}}
            </div>
        </div>
        {{else}}
        <span class="app-text-dim">-</span>
        {{end}}
    </td>

    <!-- CRC Check Status -->
    <td class="py-3.5 px-4 text-xs font-mono">
        {{if .CRCOk}}
        <span class="inline-flex items-center space-x-1">
            <img src="{{.StaticPath}}/img/check.svg" class="w-3.5 h-3.5" alt="OK" />
            <span>OK (Gültig)</span>
        </span>
        {{else}}
        <span class="inline-flex items-center space-x-1">
            <img src="{{.StaticPath}}/img/x-mark.svg" class="w-3.5 h-3.5" alt="Fehler" />
            <span>Fehler</span>
        </span>
        {{end}}
    </td>

    <!-- AFI / Security Status -->
    <td class="py-3.5 px-4 text-xs font-mono app-afi-status-cell">
        <div class="flex flex-col space-y-1">
            <div class="flex items-center space-x-1.5 flex-wrap gap-1">
                {{if .AFISecured}}
                <span class="inline-flex items-center space-x-1" title="AFI 07: Gesichert / Präsenzbestand / EAS aktiv">
                    <img src="{{.StaticPath}}/img/lock-closed.svg" class="w-3.5 h-3.5" alt="Gesichert" />
                    <span>Gesichert (07)</span>
                </span>
                {{else if .AFIUnsecured}}
                <span class="inline-flex items-center space-x-1" title="AFI C2: Entsichert / Ausgeliehen / EAS deaktiviert">
                    <img src="{{.StaticPath}}/img/lock-open.svg" class="w-3.5 h-3.5" alt="Entsichert" />
                    <span>Entsichert (C2)</span>
                </span>
                {{else if .AFI}}
                <span>AFI: {{.AFI}}</span>
                {{else}}
                <span class="app-text-dim">-</span>
                {{end}}

                {{if eq .AFIWriteStatus "success"}}
                <span class="text-[11px] font-medium opacity-75" title="AFI erfolgreich geschrieben">(Erfolg)</span>
                {{else if eq .AFIWriteStatus "error"}}
                <span class="text-[11px] font-medium opacity-75" title="{{if .AFIWriteError}}{{.AFIWriteError}}{{else}}Fehler beim AFI-Schreiben{{end}}">(Fehler)</span>
                {{else if or (eq .AFIWriteStatus "pending") .AFIWritePending}}
                <span class="text-[11px] font-medium opacity-75 animate-pulse">(Schreiben...)</span>
                {{end}}
            </div>
            {{if and (eq .AFIWriteStatus "error") .AFIWriteError}}
            <div class="text-[11px] opacity-75 font-mono" title="{{.AFIWriteError}}">
                {{.AFIWriteError}}
            </div>
            {{end}}
        </div>
    </td>

    <!-- Individual Actions -->
    <td class="py-3.5 px-4 text-xs whitespace-nowrap">
        <div class="inline-flex items-center gap-2">
            {{if or .AFISecured (not .AFIUnsecured)}}
            <button type="button"
                    hx-post="loan/afi/unsecure?uid={{.UID}}"
                    hx-target="#loan-table-body"
                    hx-swap="innerHTML"
                    class="app-btn app-btn-sm"
                    title="Diesen Transponder einzeln entsichern (C2)">
                <img src="{{.StaticPath}}/img/lock-open-emerald.svg" alt="Entsichern" />
                <span>Entsichern</span>
            </button>
            {{end}}
            {{if or .AFIUnsecured (not .AFISecured)}}
            <button type="button"
                    hx-post="loan/afi/secure?uid={{.UID}}"
                    hx-target="#loan-table-body"
                    hx-swap="innerHTML"
                    class="app-btn app-btn-sm"
                    title="Diesen Transponder einzeln sichern (07)">
                <img src="{{.StaticPath}}/img/lock-blue.svg" alt="Sichern" />
                <span>Sichern</span>
            </button>
            {{end}}
        </div>
    </td>

    <!-- Erfassungszeit -->
    <td class="py-3.5 px-4 text-xs text-right whitespace-nowrap">
        <div class="app-time-text font-mono">{{.TimeFormatted}}</div>
        <div class="text-[11px] app-time-ago time-ago" data-timestamp="{{.Timestamp}}">gerade eben</div>
    </td>
</tr>
