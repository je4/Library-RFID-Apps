<tr id="tag-{{.ID}}" class="tag-row border-b border-gray-800/60 hover:bg-slate-900/60 transition-colors animate-scan-flash group">
    <!-- Item ID -->
    <td class="py-3.5 px-4 font-mono font-medium text-white flex items-center space-x-2">
        <span class="w-2 h-2 rounded-full {{if .CRCOk}}bg-emerald-400{{else}}bg-rose-400{{end}}"></span>
        <span class="text-sm font-semibold tracking-wide text-blue-300">{{if .ItemID}}{{.ItemID}}{{else}}<span class="text-gray-500 italic">Keine ItemID</span>{{end}}</span>
    </td>

    <!-- UID with Copy Button -->
    <td class="py-3.5 px-4 font-mono text-xs text-gray-300">
        <div class="inline-flex items-center space-x-1.5 bg-gray-900/80 px-2 py-1 rounded border border-gray-800 group-hover:border-gray-700 transition-colors">
            <span>{{.UID}}</span>
            <button type="button" class="copy-uid-btn text-gray-400 hover:text-white p-0.5 rounded transition-colors" data-uid="{{.UID}}" title="UID in Zwischenablage kopieren">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
            </button>
        </div>
    </td>

    <!-- ISIL & Country -->
    <td class="py-3.5 px-4 text-xs text-gray-300">
        {{if or .ISIL .Country}}
        <div class="flex items-center space-x-1">
            {{if .Country}}<span class="px-1.5 py-0.5 rounded bg-gray-800 text-gray-300 font-mono text-[11px]">{{.Country}}</span>{{end}}
            {{if .ISIL}}<span class="font-mono text-gray-300">{{.ISIL}}</span>{{end}}
        </div>
        {{else}}
        <span class="text-gray-600">-</span>
        {{end}}
    </td>

    <!-- Parts (Multi-Part indicator) -->
    <td class="py-3.5 px-4 text-xs">
        {{if .IsMultiPart}}
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-amber-950/80 text-amber-300 border border-amber-800/70">
            Teil {{.PartNo}} / {{.Parts}}
        </span>
        {{else}}
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-gray-800/80 text-gray-400 border border-gray-700/60">
            Einzelmedium (1/1)
        </span>
        {{end}}
    </td>

    <!-- CRC Check Status -->
    <td class="py-3.5 px-4 text-xs">
        {{if .CRCOk}}
        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-950/70 text-emerald-300 border border-emerald-800/70">
            <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>OK (Gültig)</span>
        </span>
        {{else}}
        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-rose-950/70 text-rose-300 border border-rose-800/70">
            <svg class="w-3 h-3 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            <span>Fehler</span>
        </span>
        {{end}}
    </td>

    <!-- AFI / Usage -->
    <td class="py-3.5 px-4 text-xs font-mono text-gray-400">
        {{if .AFI}}
        <span class="px-1.5 py-0.5 rounded bg-indigo-950/80 text-indigo-300 border border-indigo-800/60 text-[11px]">AFI: {{.AFI}}</span>
        {{else}}
        <span class="text-gray-600">-</span>
        {{end}}
    </td>

    <!-- Timestamp -->
    <td class="py-3.5 px-4 text-xs text-right whitespace-nowrap">
        <div class="text-gray-300 font-mono">{{.TimeFormatted}}</div>
        <div class="text-[11px] text-gray-500 time-ago" data-timestamp="{{.Timestamp}}">gerade eben</div>
    </td>
</tr>
