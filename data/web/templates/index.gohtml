<!DOCTYPE html>
<html lang="{{lang}}" translate="no"{{if .Theme}} data-theme="{{.Theme}}"{{end}}{{if .ThemeMode}} data-theme-mode="{{.ThemeMode}}"{{end}}{{if .ThemeLight}} data-theme-light="{{.ThemeLight}}"{{end}}{{if .ThemeDark}} data-theme-dark="{{.ThemeDark}}"{{end}}>
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{tr "channel.title"}} - {{.ClientName}}</title>
    <!-- Automatic Skin & Dark / Light mode detection to prevent FOUC -->
    <script src="{{.StaticPath}}/js/theme-init.js"></script>
    <!-- Tailwind CSS, DaisyUI, HTMX 4 & SSE Extension (Relative Paths) -->
    <link rel="stylesheet" href="{{.StaticPath}}/css/tailwind.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/css/daisyui.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/css/daisyui-themes.min.css">
    <script src="{{.StaticPath}}/js/htmx-4.0.js"></script>
    <script src="{{.StaticPath}}/js/hx-sse.js"></script>
    <link rel="stylesheet" href="{{.StaticPath}}/scss/desk.css">
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-primary selection:text-primary-content p-4 sm:p-6 lg:p-8" sse-connect="events" data-sse-connect="events" hx-ext="sse">

    {{template "header.gohtml" .}}

    <!-- Main Content Area -->
    <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col gap-6">
        <section class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl overflow-hidden">
            <!-- Action Toolbar Header -->
            <div class="px-5 sm:px-6 py-3.5 sm:py-4 border-b border-base-200 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-2">
                        <h2 class="text-base font-semibold">{{tr "channel.available"}}</h2>
                        <span class="badge badge-sm badge-outline font-mono">{{len .Channels}}</span>
                    </div>
                </div>
                <p class="text-xs text-base-content/70">{{tr "channel.selectHint"}}</p>
            </div>

            <div class="p-5 sm:p-6 lg:p-7">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6" id="channel-selection-list">
                    {{range .Channels}}
                    <a href="{{.}}/" class="card card-border card-sm bg-base-100 hover:bg-base-200/60 border-base-200 shadow-sm hover:shadow-md transition-all duration-200 group flex flex-row items-center justify-between p-4 sm:p-5" title="{{tr "channel.label"}} {{.}} {{tr "common.open"}}">
                        <div class="flex items-center space-x-3.5">
                            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 transition-transform duration-200 group-hover:scale-105">
                                <span class="app-icon icon-channel w-5 h-5" aria-hidden="true"></span>
                            </div>
                            <div class="flex flex-col">
                                <span class="badge badge-xs badge-ghost w-fit mb-0.5">{{tr "channel.label"}}</span>
                                <span class="text-base font-bold font-mono group-hover:text-primary transition-colors">{{.}}</span>
                            </div>
                        </div>
                        <div class="text-base-content/40 group-hover:text-primary group-hover:translate-x-1 transition-all">
                            <span class="app-icon icon-arrow-right w-5 h-5" aria-hidden="true"></span>
                        </div>
                    </a>
                    {{else}}
                    <div class="col-span-full py-12 text-center text-sm text-base-content/60">
                        {{tr "channel.none"}}
                    </div>
                    {{end}}
                </div>
            </div>
        </section>
    </main>

    {{template "footer.gohtml" .}}

    <!-- Interactive script for skin selector and UI (Relative Path) -->
    <script type="module" src="{{.StaticPath}}/js/desk.js"></script>
</body>
</html>
