<!DOCTYPE html>
<html lang="de" translate="no" {{if .Theme}}data-theme="{{.Theme}}"{{end}}>
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RFID Desk - Channel-Auswahl - {{.ClientName}}</title>
    <!-- Automatic Skin & Dark / Light mode detection to prevent FOUC -->
    <script src="{{.StaticPath}}/js/theme-init.js"></script>
    <!-- Tailwind CSS, DaisyUI & Desk Styles (Relative Paths) -->
    <link rel="stylesheet" href="{{.StaticPath}}/css/tailwind.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/css/daisyui.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/scss/desk.css">
</head>
<body class="app-body min-h-screen flex flex-col justify-between selection:bg-blue-600 selection:text-white p-4 sm:p-6 lg:p-8">

    {{template "header.gohtml" .}}

    <!-- Main Content Area -->
    <main class="app-main">
        <section class="app-panel">
            <!-- Action Toolbar Header -->
            <div class="app-panel-toolbar">
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-2">
                        <h2 class="text-base font-semibold app-panel-title">Verfügbare Channels</h2>
                        <span class="badge badge-sm badge-outline font-mono app-count-badge">{{len .Channels}}</span>
                    </div>
                </div>
                <p class="text-xs app-meta-text">Wählen Sie einen Channel aus, um die Desk- und Ausleihansicht zu öffnen</p>
            </div>

            <div class="p-5 sm:p-6 lg:p-8">
                <div class="channel-selection-grid" id="channel-selection-list">
                    {{range .Channels}}
                    <a href="{{.}}/" class="card card-bordered card-compact transition-all duration-200 app-channel-card group" title="Channel {{.}} öffnen">
                        <div class="channel-card-left">
                            <div class="channel-card-icon">
                                <span class="app-icon icon-channel w-5 h-5" aria-hidden="true"></span>
                            </div>
                            <div class="channel-card-info">
                                <span class="badge badge-xs badge-ghost channel-card-badge">Channel</span>
                                <span class="channel-card-name">{{.}}</span>
                            </div>
                        </div>
                        <div class="channel-card-arrow">
                            <span class="app-icon icon-arrow-right w-5 h-5" aria-hidden="true"></span>
                        </div>
                    </a>
                    {{else}}
                    <div class="col-span-full py-12 text-center text-sm app-meta-text">
                        Keine Channels konfiguriert.
                    </div>
                    {{end}}
                </div>
            </div>
        </section>
    </main>

    {{template "footer.gohtml" .}}

    <!-- Interactive script for skin selector and UI (Relative Path) -->
    <script type="module" src="{{.StaticPath}}/js/desk.js"></script>
</body>
</html>
