<!DOCTYPE html>
<html lang="de" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RFID Desk - Channel-Auswahl - {{.ClientName}}</title>
    <!-- Automatic Dark / Light mode detection to prevent FOUC -->
    <script>
        (function() {
            function syncTheme() {
                var isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (isDark) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.remove('light');
                } else {
                    document.documentElement.classList.add('light');
                    document.documentElement.classList.remove('dark');
                }
            }
            syncTheme();
            if (window.matchMedia) {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);
            }
        })();
    </script>
    <!-- Tailwind CSS & Desk Styles (Relative Paths) -->
    <link rel="stylesheet" href="static/css/tailwind.min.css">
    <link rel="stylesheet" href="static/scss/desk.css">
</head>
<body class="app-body min-h-screen flex flex-col justify-between selection:bg-blue-600 selection:text-white p-4 sm:p-6 lg:p-8">

    {{template "header.gohtml" .}}

    <!-- Main Content Area -->
    <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col space-y-6">
        <section class="rounded-2xl app-panel border shadow-2xl overflow-hidden flex flex-col">
            <!-- Action Toolbar Header -->
            <div class="p-4 sm:p-5 border-b app-panel-toolbar flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-2">
                        <h2 class="text-base font-semibold app-panel-title">Verfügbare Channels</h2>
                        <span class="px-2 py-0.5 text-xs font-semibold rounded-full app-count-badge">{{len .Channels}}</span>
                    </div>
                </div>
                <p class="text-xs app-meta-text">Wählen Sie einen Channel aus, um die Desk- und Ausleihansicht zu öffnen</p>
            </div>

            <div class="p-5 sm:p-6 lg:p-8">
                <div class="channel-selection-grid" id="channel-selection-list">
                    {{range .Channels}}
                    <a href="{{.}}/" class="app-channel-card group" title="Channel {{.}} öffnen">
                        <div class="channel-card-left">
                            <div class="channel-card-icon">
                                <img src="static/img/channel.svg" class="w-5 h-5" alt="Channel" />
                            </div>
                            <div class="channel-card-info">
                                <span class="channel-card-badge">Channel</span>
                                <span class="channel-card-name">{{.}}</span>
                            </div>
                        </div>
                        <div class="channel-card-arrow">
                            <img src="static/img/arrow-right.svg" class="w-5 h-5" alt="Öffnen" />
                        </div>
                    </a>
                    {{else}}
                    <div class="col-span-full py-12 text-center text-sm app-meta-text">
                        Keine Channels konfiguriert.
                    </div>
                    {{end}}
                </div>
            </div>
        </section>
    </main>

    {{template "footer.gohtml" .}}

</body>
</html>
