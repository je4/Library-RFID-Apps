<!DOCTYPE html>
<html lang="de" translate="no" {{if .Theme}}data-theme="{{.Theme}}"{{end}}>
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RFID Desk - {{.ClientName}}</title>
    <!-- Automatic Skin & Dark / Light mode detection to prevent FOUC -->
    <script src="{{.StaticPath}}/js/theme-init.js"></script>
    <!-- Tailwind CSS, DaisyUI, HTMX 4 & SSE Extension (Relative Paths) -->
    <link rel="stylesheet" href="{{.StaticPath}}/css/tailwind.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/css/daisyui.min.css">
    <script src="{{.StaticPath}}/js/htmx-4.0.js"></script>
    <script src="{{.StaticPath}}/js/hx-sse.js"></script>
    <link rel="stylesheet" href="{{.StaticPath}}/scss/desk.css">
</head>
<body class="app-body min-h-screen flex flex-col justify-between selection:bg-blue-600 selection:text-white p-4 sm:p-6 lg:p-8" sse-connect="events" data-sse-connect="events" hx-ext="sse">

    {{template "header.gohtml" .}}

    <!-- Main Content Area -->
    <main class="app-main">

        <!-- Top Navigation / Action Bar -->
        <nav class="flex items-center flex-wrap gap-4" aria-label="Aktionsleiste">
            <!-- Ausleihe & Rückgabe (Loan) Action Card -->
            <a href="loan" id="nav-loan-btn" class="card card-bordered bg-base-100 hover:shadow-lg transition-all duration-300 app-loan-action-card group flex-1 min-w-[220px]" title="Zur Ausleihe und Rückgabe wechseln">
                <div class="card-body p-4 sm:p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between w-full mb-3">
                        <div class="card-icon-box transition-transform duration-300 group-hover:scale-110">
                            <span class="app-icon icon-book w-7 h-7" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div>
                        <span class="card-subtitle text-[11px] font-semibold uppercase tracking-wider block mb-0.5">Funktion</span>
                        <span class="card-title text-sm sm:text-base font-bold tracking-tight block">Ausleihe &amp; Rückgabe</span>
                    </div>
                </div>
            </a>

            <!-- Medium kodieren (Encode) Action Card -->
            <a href="encode" id="nav-encode-btn" class="card card-bordered bg-base-100 hover:shadow-lg transition-all duration-300 app-encode-action-card group flex-1 min-w-[220px]" title="Zu Medium kodieren wechseln">
                <div class="card-body p-4 sm:p-5 flex flex-col justify-between">
                    <div class="flex items-center justify-between w-full mb-3">
                        <div class="card-icon-box transition-transform duration-300 group-hover:scale-110">
                            <span class="app-icon icon-tag w-7 h-7" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div>
                        <span class="card-subtitle text-[11px] font-semibold uppercase tracking-wider block mb-0.5">Funktion</span>
                        <span class="card-title text-sm sm:text-base font-bold tracking-tight block">Medium kodieren</span>
                    </div>
                </div>
            </a>
        </nav>

        <!-- Metrics Overview Grid -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Total Tags Card -->
            <div class="stats shadow-sm bg-base-100 border border-base-300/60 app-card">
                <div class="stat p-4">
                    <div class="stat-figure">
                        <div class="w-10 h-10 rounded-lg app-icon-box-blue flex items-center justify-center">
                            <span class="app-icon icon-tag w-5 h-5" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div class="stat-title text-xs font-semibold app-metric-label">Gelesene RFID-Tags</div>
                    <div id="stats-total-tags" class="stat-value text-2xl font-bold font-mono app-metric-val mt-1">{{len .Tags}}</div>
                </div>
            </div>

            <!-- Target Reader / Channel Card -->
            <div class="stats shadow-sm bg-base-100 border border-base-300/60 app-card">
                <div class="stat p-4">
                    <div class="stat-figure">
                        <div class="w-10 h-10 rounded-lg app-icon-box-indigo flex items-center justify-center">
                            <span class="app-icon icon-channel w-5 h-5" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div class="stat-title text-xs font-semibold app-metric-label">Channel</div>
                    <div class="stat-value text-sm font-semibold font-mono app-metric-val-indigo mt-1 truncate max-w-[160px]">{{if .Channel}}{{.Channel}}{{else}}all{{end}}</div>
                </div>
            </div>

            <!-- Target Reader Card -->
            <div class="stats shadow-sm bg-base-100 border border-base-300/60 app-card">
                <div class="stat p-4">
                    <div class="stat-figure">
                        <div class="w-10 h-10 rounded-lg app-icon-box-cyan flex items-center justify-center">
                            <span class="app-icon icon-chip w-5 h-5" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div class="stat-title text-xs font-semibold app-metric-label">Standard Reader</div>
                    <div class="stat-value text-sm font-semibold font-mono app-metric-val-cyan mt-1 truncate max-w-[160px]">{{if .DefaultReader}}{{.DefaultReader}}{{else}}Automatisch / Alle{{end}}</div>
                </div>
            </div>

            <!-- Uptime Card -->
            <div class="stats shadow-sm bg-base-100 border border-base-300/60 app-card">
                <div class="stat p-4">
                    <div class="stat-figure">
                        <div class="w-10 h-10 rounded-lg app-icon-box-emerald flex items-center justify-center">
                            <span class="app-icon icon-clock w-5 h-5" aria-hidden="true"></span>
                        </div>
                    </div>
                    <div class="stat-title text-xs font-semibold app-metric-label">Laufzeit</div>
                    <div class="stat-value text-sm font-semibold font-mono app-metric-val-emerald mt-1">{{.Uptime}}</div>
                </div>
            </div>
        </section>

        <!-- Live Scanned Tags Panel -->
        <section class="app-panel flex-1">
            <!-- Toolbar -->
            <div class="app-panel-toolbar">
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-2">
                        <h2 class="text-base font-semibold app-panel-title">Live NFC / RFID Transponder Stream</h2>
                        <span id="tag-count-badge" class="badge badge-sm badge-outline font-mono app-count-badge">{{len .Tags}}</span>
                    </div>
                </div>

                <div class="flex items-center space-x-2.5">
                    <!-- Filter Input -->
                    <div class="relative flex items-center">
                        <input id="tag-filter-input" type="text" placeholder="Filtern nach ItemID / UID..." class="input input-sm input-bordered app-input has-leading-icon w-48 sm:w-64 font-mono">
                        <span class="app-icon icon-search w-4 h-4 text-base-content/50 absolute left-2.5 pointer-events-none" aria-hidden="true"></span>
                    </div>

                    <!-- Clear List Button (HTMX 4 POST) -->
                    <button hx-post="tags/clear" hx-target="#tags-table-body" hx-swap="innerHTML" type="button" class="btn btn-sm btn-ghost text-error hover:bg-error hover:text-error-content app-btn flex items-center gap-1.5" title="Transponder-Liste leeren">
                        <span class="app-icon icon-trash w-3.5 h-3.5 shrink-0" aria-hidden="true"></span>
                        <span>Leeren</span>
                    </button>
                </div>
            </div>

            <!-- Tags Table with SSE Connection -->
            <div class="transponder-stream-scroll flex-1">
                <table class="table table-zebra table-pin-rows w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10 shadow-sm">
                        <tr class="text-[11px] font-semibold uppercase tracking-wider">
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Item ID (Medium)</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Transponder UID</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Reader (Sender)</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Bibliothek / ISIL</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Teile (Multi-Part)</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">CRC Prüfsumme</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">AFI</th>
                            <th scope="col" class="py-3 px-4 text-right whitespace-nowrap">Erfassungszeit</th>
                        </tr>
                    </thead>
                    <tbody id="tags-table-body" sse-swap="tag_read" data-sse-swap="tag_read" hx-swap="afterbegin">
                        {{template "tags_table.gohtml" .}}
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    {{template "footer.gohtml" .}}

    <!-- Interactive script for audio, counters and filtering (Relative Path) -->
    <script type="module" src="{{.StaticPath}}/js/desk.js"></script>
</body>
</html>
