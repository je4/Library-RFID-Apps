<!DOCTYPE html>
<html lang="de" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RFID Desk - {{.ClientName}}</title>
    <!-- Automatic Dark / Light mode detection to prevent FOUC -->
    <script>
        (function() {
            function syncTheme() {
                var isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (isDark) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.remove('light');
                } else {
                    document.documentElement.classList.add('light');
                    document.documentElement.classList.remove('dark');
                }
            }
            syncTheme();
            if (window.matchMedia) {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);
            }
        })();
    </script>
    <!-- Tailwind CSS, HTMX 4 & SSE Extension (Relative Paths) -->
    <link rel="stylesheet" href="../static/css/tailwind.min.css">
    <script src="../static/js/htmx-4.0.js"></script>
    <script src="../static/js/hx-sse.js"></script>
    <link rel="stylesheet" href="../static/css/desk.css">
</head>
<body class="app-body min-h-screen flex flex-col justify-between selection:bg-blue-600 selection:text-white p-4 sm:p-6 lg:p-8" sse-connect="events" data-sse-connect="events" hx-ext="sse">

    {{template "header.gohtml" .}}

    <!-- Main Content Area -->
    <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col space-y-6">

        <!-- Top Navigation / Action Bar (Single Elegant Loan Action Button) -->
        <nav class="flex items-center" aria-label="Aktionsleiste">
            <!-- Ausleihe & Rückgabe (Loan) Action Card -->
            <a href="loan" id="nav-loan-btn" class="app-loan-action-card group flex flex-col justify-between p-4 sm:p-5 rounded-2xl transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-lg" title="Zur Ausleihe und Rückgabe wechseln">
                <div class="flex items-center justify-between w-full mb-3">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center card-icon-box shadow-md transition-transform duration-300 group-hover:scale-110">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            <path d="M9 7h6"></path>
                            <path d="M9 11h6"></path>
                            <path d="M16 16l3-3m0 0l-3-3m3 3H11" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </div>
                    <span class="card-arrow-badge flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
                        </svg>
                    </span>
                </div>
                <div>
                    <span class="card-subtitle text-[11px] font-semibold uppercase tracking-wider block mb-0.5">Funktion</span>
                    <span class="card-title text-sm sm:text-base font-bold tracking-tight block">Ausleihe &amp; Rückgabe</span>
                </div>
            </a>
        </nav>

        <!-- Metrics Overview Grid -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Total Tags Card -->
            <div class="p-4 rounded-xl app-card flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium app-metric-label">Gelesene RFID-Tags</div>
                    <div id="stats-total-tags" class="text-2xl font-bold font-mono app-metric-val mt-1">{{len .Tags}}</div>
                </div>
                <div class="w-10 h-10 rounded-lg app-icon-box-blue flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                    </svg>
                </div>
            </div>

            <!-- Target Reader / Channel Card -->
            <div class="p-4 rounded-xl app-card flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium app-metric-label">Channel</div>
                    <div class="text-sm font-semibold font-mono app-metric-val-indigo mt-1 truncate max-w-[160px]">{{if .Channel}}{{.Channel}}{{else}}all{{end}}</div>
                </div>
                <div class="w-10 h-10 rounded-lg app-icon-box-indigo flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                </div>
            </div>

            <!-- Target Reader Card -->
            <div class="p-4 rounded-xl app-card flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium app-metric-label">Standard Reader</div>
                    <div class="text-sm font-semibold font-mono app-metric-val-cyan mt-1 truncate max-w-[160px]">{{if .DefaultReader}}{{.DefaultReader}}{{else}}Automatisch / Alle{{end}}</div>
                </div>
                <div class="w-10 h-10 rounded-lg app-icon-box-cyan flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
                    </svg>
                </div>
            </div>

            <!-- Uptime Card -->
            <div class="p-4 rounded-xl app-card flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium app-metric-label">Laufzeit</div>
                    <div class="text-sm font-semibold font-mono app-metric-val-emerald mt-1">{{.Uptime}}</div>
                </div>
                <div class="w-10 h-10 rounded-lg app-icon-box-emerald flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
        </section>

        <!-- Live Scanned Tags Panel -->
        <section class="rounded-2xl app-panel border shadow-2xl overflow-hidden flex flex-col flex-1">
            <!-- Toolbar -->
            <div class="p-4 sm:p-5 border-b app-panel-toolbar flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-2">
                        <h2 class="text-base font-semibold app-panel-title">Live NFC / RFID Transponder Stream</h2>
                        <span id="tag-count-badge" class="px-2 py-0.5 text-xs font-semibold rounded-full app-count-badge">{{len .Tags}}</span>
                    </div>
                </div>

                <div class="flex items-center space-x-2.5">
                    <!-- Filter Input -->
                    <div class="relative flex items-center">
                        <input id="tag-filter-input" type="text" placeholder="Filtern nach ItemID / UID..." class="w-48 sm:w-64 app-input text-xs rounded-lg pl-8 pr-3 py-1.5 focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 font-mono transition-all">
                        <svg class="w-4 h-4 app-text-dim absolute left-2.5 pointer-events-none" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>

                    <!-- Clear List Button (HTMX 4 POST) -->
                    <button hx-post="tags/clear" hx-target="#tags-table-body" hx-swap="innerHTML" type="button" class="px-3 py-1.5 text-xs font-medium rounded-lg app-clear-btn transition-colors inline-flex items-center gap-1.5" title="Transponder-Liste leeren">
                        <svg class="w-3.5 h-3.5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                        <span>Leeren</span>
                    </button>
                </div>
            </div>

            <!-- Tags Table with SSE Connection -->
            <div class="transponder-stream-scroll flex-1">
                <table class="w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10 shadow-sm">
                        <tr class="text-[11px] font-semibold uppercase tracking-wider">
                            <th scope="col" class="py-3 px-4">Item ID (Medium)</th>
                            <th scope="col" class="py-3 px-4">Transponder UID</th>
                            <th scope="col" class="py-3 px-4">Reader (Sender)</th>
                            <th scope="col" class="py-3 px-4">ISIL / Land</th>
                            <th scope="col" class="py-3 px-4">Teile (Multi-Part)</th>
                            <th scope="col" class="py-3 px-4">CRC Prüfsumme</th>
                            <th scope="col" class="py-3 px-4">AFI</th>
                            <th scope="col" class="py-3 px-4 text-right">Erfassungszeit</th>
                        </tr>
                    </thead>
                    <tbody id="tags-table-body" sse-swap="tag_read" data-sse-swap="tag_read" hx-swap="afterbegin">
                        {{template "tags_table.gohtml" .}}
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    {{template "footer.gohtml" .}}

    <!-- Interactive script for audio, counters and filtering (Relative Path) -->
    <script src="../static/js/desk.js"></script>
</body>
</html>
