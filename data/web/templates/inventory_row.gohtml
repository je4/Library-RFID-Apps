<tr id="inv-row-{{.UID}}" class="hover transition-colors {{if .IsDuplicate}}bg-warning/10{{else if eq .DispatchState "error"}}bg-error/10{{end}}">
    <!-- Item ID / Barcode -->
    <td class="py-3 px-4 sm:px-5 font-mono font-semibold text-sm">
        {{if .ItemID}}
            <span class="text-primary font-bold">{{.ItemID}}</span>
        {{else if .IsEmpty}}
            <span class="badge badge-sm badge-warning font-sans">Leer / Unkodiert</span>
        {{else}}
            <span class="text-base-content/40 italic">Keine ID</span>
        {{end}}
    </td>

    <!-- Transponder UID -->
    <td class="py-3 px-4 sm:px-5 font-mono text-xs text-base-content/80 whitespace-nowrap">
        {{.UID}}
    </td>

    <!-- Shelf / Location Marker -->
    <td class="py-3 px-4 sm:px-5 text-xs font-mono">
        {{if .Marker}}
            <span class="badge badge-sm badge-outline font-semibold">{{.Marker}}</span>
        {{else}}
            <span class="text-base-content/40 italic">-</span>
        {{end}}
    </td>

    <!-- ISIL & Country & Library Flyout -->
    <td class="py-3 px-4 sm:px-5 text-xs">
        {{if or .ISIL .Country .ISILName}}
        <div class="app-isil-container">
            {{if .ISILName}}
            <span class="font-sans font-semibold text-xs tracking-tight break-words whitespace-normal block mb-0.5" title="{{.ISILName}}">{{.ISILName}}</span>
            {{end}}
            <div class="font-mono text-[11px] flex items-center space-x-1.5 {{if not .ISILName}}font-semibold text-xs{{else}}text-base-content/70{{end}}">
                <span>{{if .Country}}{{.Country}}-{{end}}{{.ISIL}}</span>
                {{if .ISILEntry}}
                <div class="app-isil-info-wrapper relative inline-flex items-center">
                    <span class="app-isil-info-btn inline-flex items-center justify-center p-0.5 rounded cursor-pointer text-primary hover:text-primary-focus transition-colors" title="Bibliotheksdetails anzeigen (Mouseover)">
                        <img src="{{.StaticPath}}/img/icons/info-circle.svg" class="w-3.5 h-3.5 flex-shrink-0" alt="Info" />
                    </span>

                    <!-- Detailed Library Flyout Template -->
                    <template class="app-isil-flyout-template">
                        <div class="flex items-start justify-between gap-2 border-b border-base-200 pb-2 mb-2">
                            <div>
                                <h4 class="text-xs font-bold leading-tight font-sans">{{.ISILEntry.NameOriginal}}</h4>
                                {{if and .ISILEntry.NameDE (ne .ISILEntry.NameDE .ISILEntry.NameOriginal)}}
                                <div class="text-[11px] text-base-content/70 font-sans mt-0.5">{{.ISILEntry.NameDE}}</div>
                                {{else if and .ISILEntry.NameFR (ne .ISILEntry.NameFR .ISILEntry.NameOriginal)}}
                                <div class="text-[11px] text-base-content/70 font-sans mt-0.5">{{.ISILEntry.NameFR}}</div>
                                {{else if and .ISILEntry.NameIT (ne .ISILEntry.NameIT .ISILEntry.NameOriginal)}}
                                <div class="text-[11px] text-base-content/70 font-sans mt-0.5">{{.ISILEntry.NameIT}}</div>
                                {{else if and .ISILEntry.NameEN (ne .ISILEntry.NameEN .ISILEntry.NameOriginal)}}
                                <div class="text-[11px] text-base-content/70 font-sans mt-0.5">{{.ISILEntry.NameEN}}</div>
                                {{end}}
                            </div>
                            <div class="flex flex-col items-end gap-1 flex-shrink-0">
                                <span class="badge badge-xs badge-primary font-mono">{{.ISILEntry.ISIL}}</span>
                                {{if .ISILEntry.Status}}
                                <span class="inline-flex items-center gap-1 text-[10px] font-medium {{if eq .ISILEntry.Status "aktiv"}}text-success{{else}}text-base-content/40{{end}}">
                                    <span class="w-1.5 h-1.5 rounded-full {{if eq .ISILEntry.Status "aktiv"}}bg-success{{else}}bg-base-content/30{{end}}"></span>
                                    {{.ISILEntry.Status}}
                                </span>
                                {{end}}
                            </div>
                        </div>

                        <div class="space-y-2 text-[11px] leading-relaxed font-sans">
                            {{if .ISILEntry.Mutterinstitution}}
                            <div>
                                <span class="text-base-content/60 font-medium">Mutterinstitution:</span>
                                <span class="font-medium break-words">{{.ISILEntry.Mutterinstitution}}</span>
                            </div>
                            {{end}}

                            {{if or .ISILEntry.Institutionstyp .ISILEntry.Institutionskategorie .ISILEntry.VZSigel}}
                            <div class="grid grid-cols-2 gap-x-2 gap-y-1 pt-1 border-t border-base-200/60">
                                {{if .ISILEntry.Institutionstyp}}
                                <div>
                                    <span class="text-base-content/60">Typ:</span>
                                    <span>{{.ISILEntry.Institutionstyp}}</span>
                                </div>
                                {{end}}
                                {{if .ISILEntry.Institutionskategorie}}
                                <div>
                                    <span class="text-base-content/60">Kategorie:</span>
                                    <span>{{.ISILEntry.Institutionskategorie}}</span>
                                </div>
                                {{end}}
                                {{if .ISILEntry.VZSigel}}
                                <div class="col-span-2">
                                    <span class="text-base-content/60">VZ-Sigel:</span>
                                    <span class="font-mono">{{.ISILEntry.VZSigel}}</span>
                                </div>
                                {{end}}
                            </div>
                            {{end}}

                            {{if or .ISILEntry.Strasse .ISILEntry.Adresszusatz .ISILEntry.Postfach .ISILEntry.Postleitzahl .ISILEntry.Ortschaft .ISILEntry.Kanton .ISILEntry.Land}}
                            <div class="pt-1 border-t border-base-200/60 text-base-content/80">
                                {{if .ISILEntry.Strasse}}<div>{{.ISILEntry.Strasse}}{{if .ISILEntry.Adresszusatz}}, {{.ISILEntry.Adresszusatz}}{{end}}</div>{{else if .ISILEntry.Adresszusatz}}<div>{{.ISILEntry.Adresszusatz}}</div>{{end}}
                                {{if .ISILEntry.Postfach}}<div>Postfach: {{.ISILEntry.Postfach}}</div>{{end}}
                                {{if or .ISILEntry.Postleitzahl .ISILEntry.Ortschaft .ISILEntry.Kanton}}<div>{{if .ISILEntry.Postleitzahl}}{{.ISILEntry.Postleitzahl}} {{end}}{{.ISILEntry.Ortschaft}}{{if .ISILEntry.Kanton}} ({{.ISILEntry.Kanton}}){{end}}</div>{{end}}
                                {{if .ISILEntry.Land}}<div>{{.ISILEntry.Land}}</div>{{end}}
                            </div>
                            {{end}}

                            {{if or .ISILEntry.Webseite .ISILEntry.OnlineKatalog}}
                            <div class="flex items-center gap-3 pt-1 border-t border-base-200/60 text-primary">
                                {{if .ISILEntry.Webseite}}
                                <a href="{{.ISILEntry.Webseite}}" target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-1" title="Webseite öffnen">
                                    <span>Webseite</span>
                                    <span class="app-icon icon-external-link w-3 h-3" aria-hidden="true"></span>
                                </a>
                                {{end}}
                                {{if .ISILEntry.OnlineKatalog}}
                                <a href="{{.ISILEntry.OnlineKatalog}}" target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-1" title="Online-Katalog öffnen">
                                    <span>Katalog</span>
                                    <span class="app-icon icon-external-link w-3 h-3" aria-hidden="true"></span>
                                </a>
                                {{end}}
                            </div>
                            {{end}}
                        </div>
                    </template>
                </div>
                {{end}}
            </div>
        </div>
        {{else}}
        <span class="text-base-content/40">-</span>
        {{end}}
    </td>

    <!-- Parts / Multi-part Item -->
    <td class="py-3 px-4 sm:px-5 text-xs font-mono whitespace-nowrap">
        {{if gt .Parts 1}}
            <span class="badge badge-xs badge-info font-bold">{{.PartNo}}/{{.Parts}}</span>
        {{else if eq .Parts 1}}
            <span class="text-base-content/60">1/1</span>
        {{else}}
            <span class="text-base-content/40">-</span>
        {{end}}
    </td>

    <!-- AFI Security Status -->
    <td class="py-3 px-4 sm:px-5 text-xs whitespace-nowrap">
        {{if eq .AFI "07"}}
            <span class="badge badge-xs badge-success text-[10px] font-semibold gap-1" title="AFI 07 - Gesichert">
                <span class="w-1.5 h-1.5 rounded-full bg-success-content" aria-hidden="true"></span>
                Gesichert
            </span>
        {{else if eq .AFI "C2"}}
            <span class="badge badge-xs badge-warning text-[10px] font-semibold gap-1" title="AFI C2 - Entsichert">
                <span class="w-1.5 h-1.5 rounded-full bg-warning-content" aria-hidden="true"></span>
                Entsichert
            </span>
        {{else if .AFI}}
            <span class="badge badge-xs badge-ghost text-[10px] font-mono">{{.AFI}}</span>
        {{else}}
            <span class="text-base-content/40">-</span>
        {{end}}
    </td>

    <!-- Webservice Dispatch Status -->
    <td class="py-3 px-4 sm:px-5 text-xs whitespace-nowrap">
        {{if .IsDuplicate}}
            <span class="badge badge-xs badge-warning gap-1 font-semibold" title="Dublette: Transponder wurde in dieser Sitzung bereits erfasst">
                <span class="app-icon icon-copy w-3 h-3" aria-hidden="true"></span>
                Dublette
            </span>
        {{else if eq .DispatchState "success"}}
            <span class="badge badge-xs badge-success gap-1 font-semibold" title="Erfolgreich an Webservice übermittelt (HTTP {{if .HTTPStatus}}{{.HTTPStatus}}{{else}}200{{end}})">
                <span class="app-icon icon-check w-3 h-3" aria-hidden="true"></span>
                Übermittelt
            </span>
        {{else if eq .DispatchState "error"}}
            <div class="flex items-center gap-1.5">
                <span class="badge badge-xs badge-error gap-1 font-semibold" title="{{if .DispatchError}}{{.DispatchError}}{{else}}Webservice-Fehler{{end}}">
                    <span class="app-icon icon-alert w-3 h-3" aria-hidden="true"></span>
                    Fehlgeschlagen
                </span>
                <button hx-post="inventory/retry?uid={{.UID}}"
                        hx-swap="none"
                        type="button"
                        class="btn btn-ghost btn-xs px-1 text-primary hover:bg-primary/20"
                        title="Erneut an Webservice senden">
                    <span class="app-icon icon-refresh w-3 h-3" aria-hidden="true"></span>
                </button>
            </div>
        {{else if eq .DispatchState "pending"}}
            <span class="badge badge-xs badge-info gap-1 animate-pulse">
                Wird gesendet...
            </span>
        {{else}}
            <span class="badge badge-xs badge-ghost">Lokal</span>
        {{end}}
    </td>

    <!-- Timestamp -->
    <td class="py-3 px-4 sm:px-5 text-right font-mono text-xs text-base-content/60 whitespace-nowrap">
        {{if .TimeFormatted}}{{.TimeFormatted}}{{else if not .ReadTime.IsZero}}{{.ReadTime.Format "15:04:05"}}{{else}}-{{end}}
    </td>
</tr>
