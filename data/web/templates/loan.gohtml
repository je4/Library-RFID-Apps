<!DOCTYPE html>
<html lang="de" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RFID Ausleihe &amp; Rückgabe - {{.ClientName}}</title>
    <!-- Automatic Dark / Light mode detection to prevent FOUC -->
    <script>
        (function() {
            function syncTheme() {
                var isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (isDark) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.remove('light');
                } else {
                    document.documentElement.classList.add('light');
                    document.documentElement.classList.remove('dark');
                }
            }
            syncTheme();
            if (window.matchMedia) {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);
            }
        })();
    </script>
    <!-- Tailwind CSS, HTMX 4 & SSE Extension (Relative Paths) -->
    <link rel="stylesheet" href="../static/css/tailwind.min.css">
    <script src="../static/js/htmx-4.0.js"></script>
    <script src="../static/js/hx-sse.js"></script>
    <link rel="stylesheet" href="../static/scss/desk.css">
</head>
<body class="app-body min-h-screen flex flex-col justify-between selection:bg-blue-600 selection:text-white p-4 sm:p-6 lg:p-8" sse-connect="events" data-sse-connect="events" hx-ext="sse">

    {{template "header.gohtml" .}}

    <!-- Main Content Area -->
    <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col space-y-6">

        <!-- Metrics Overview Grid -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Active Media on Pad Card -->
            <div class="p-4 rounded-xl app-card flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium app-metric-label">Aufliegende Medien</div>
                    <div id="stats-active-tags" class="text-2xl font-bold font-mono app-metric-val mt-1">{{len .Tags}}</div>
                </div>
                <div class="w-10 h-10 rounded-lg app-icon-box-emerald flex items-center justify-center">
                    <img src="../static/img/book-green.svg" class="w-5 h-5" alt="Medien" />
                </div>
            </div>

            <!-- Configured Reader Card -->
            <div class="p-4 rounded-xl app-card flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium app-metric-label">Konfigurierter Reader</div>
                    <div class="text-sm font-semibold font-mono app-metric-val-cyan mt-1 truncate max-w-[180px]">{{if .DefaultReader}}{{.DefaultReader}}{{else}}Automatisch / Alle{{end}}</div>
                </div>
                <div class="w-10 h-10 rounded-lg app-icon-box-cyan flex items-center justify-center">
                    <img src="../static/img/chip.svg" class="w-5 h-5" alt="Reader" />
                </div>
            </div>

            <!-- Channel Card -->
            <div class="p-4 rounded-xl app-card flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium app-metric-label">Channel</div>
                    <div class="text-sm font-semibold font-mono app-metric-val-indigo mt-1 truncate max-w-[180px]">{{if .Channel}}{{.Channel}}{{else}}all{{end}}</div>
                </div>
                <div class="w-10 h-10 rounded-lg app-icon-box-indigo flex items-center justify-center">
                    <img src="../static/img/channel.svg" class="w-5 h-5" alt="Channel" />
                </div>
            </div>
        </section>

        <!-- Active Media Table & Control Panel -->
        <section class="rounded-2xl app-panel border shadow-2xl overflow-hidden flex flex-col flex-1">
            <!-- Action Toolbar -->
            <div class="p-4 sm:p-5 border-b app-panel-toolbar flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-2">
                        <h2 class="text-base font-semibold app-panel-title">Aufliegende Medien auf Reader</h2>
                        <span id="loan-tag-count-badge" class="px-2 py-0.5 text-xs font-semibold rounded-full app-count-badge">{{len .Tags}}</span>
                    </div>
                </div>

                <!-- Primary Action Buttons: Copy All ItemIDs, Entsichern, Sichern -->
                <div class="flex items-center flex-wrap gap-2">
                    <!-- Copy All Item IDs Button -->
                    <button id="btn-copy-all-itemids" type="button" class="px-3 py-1.5 text-[11px] font-medium rounded app-btn transition-colors inline-flex items-center gap-2 whitespace-nowrap cursor-pointer" title="Alle aufgelisteten Item-IDs in die Zwischenablage kopieren">
                        <img src="../static/img/copy.svg" class="w-3.5 h-3.5 shrink-0 block" alt="Kopieren" />
                        <span id="copy-all-label">Item-IDs kopieren</span>
                    </button>

                    <!-- Unsecure Button (AFI C2) -->
                    <button id="btn-unsecure" hx-post="loan/afi/unsecure" hx-target="#loan-table-body" hx-swap="innerHTML" type="button" class="px-3 py-1.5 text-[11px] font-medium rounded app-btn transition-colors inline-flex items-center gap-2 whitespace-nowrap cursor-pointer" title="AFI auf C2 (Entsichern / Ausgeliehen / EAS deaktiviert) setzen">
                        <img src="../static/img/lock-open-emerald.svg" class="w-3.5 h-3.5 shrink-0 block" alt="Entsichern" />
                        <span>Entsichern</span>
                    </button>

                    <!-- Secure Button (AFI 07) -->
                    <button id="btn-secure" hx-post="loan/afi/secure" hx-target="#loan-table-body" hx-swap="innerHTML" type="button" class="px-3 py-1.5 text-[11px] font-medium rounded app-btn transition-colors inline-flex items-center gap-2 whitespace-nowrap cursor-pointer" title="AFI auf 07 (Sichern / Präsenzbestand / EAS aktiv) setzen">
                        <img src="../static/img/lock-blue.svg" class="w-3.5 h-3.5 shrink-0 block" alt="Sichern" />
                        <span>Sichern</span>
                    </button>
                </div>
            </div>

            <!-- Status Notification Banner -->
            <div id="action-notification" class="hidden px-4 py-2 text-xs font-medium border-b transition-all flex items-center justify-between">
                <span id="action-notification-text"></span>
            </div>

            <!-- Active Tags Table with SSE Connection -->
            <div class="transponder-stream-scroll flex-1">
                <table class="w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10 shadow-sm">
                        <tr class="text-[11px] font-semibold uppercase tracking-wider">
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Item ID (Medium)</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Transponder UID</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Teile (Multi-Part)</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Bibliothek / ISIL</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">CRC Prüfsumme</th>
                            <th scope="col" class="py-3 px-4 app-afi-status-cell">AFI Sicherheitsstatus</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Aktionen</th>
                            <th scope="col" class="py-3 px-4 text-right whitespace-nowrap">Zuletzt erfasst</th>
                        </tr>
                    </thead>
                    <tbody id="loan-table-body" sse-swap="loan_tags" data-sse-swap="loan_tags" hx-swap="innerHTML">
                        {{template "loan_table.gohtml" .}}
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    {{template "footer.gohtml" .}}

    <!-- AFI Writing Modal Dialog / Waiting Overlay -->
    <div id="afi-modal-overlay" class="app-afi-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="afi-modal-title">
        <div class="app-afi-modal-dialog">
            <div class="app-afi-spinner-container">
                <div class="app-afi-spinner-ring"></div>
                <div class="app-afi-spinner-icon" id="afi-modal-icon">
                    <img src="../static/img/lock-blue.svg" class="w-6 h-6" alt="AFI" />
                </div>
            </div>
            <h3 id="afi-modal-title" class="app-afi-modal-title">AFI wird geschrieben...</h3>
            <p id="afi-modal-message" class="app-afi-modal-desc">
                Bitte warten Sie, bis der Sicherheitsstatus auf dem Lesefeld aktualisiert wurde. Bitte keine Medien vom Lesegerät entfernen.
            </p>
            <div class="app-afi-modal-badge">
                <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
                <span id="afi-modal-status-text">RFID-Kommunikation aktiv...</span>
            </div>
            <div id="afi-modal-timeout-hint" class="app-afi-modal-hint">
                Timeout-Schutz aktiv (10s)
            </div>
        </div>
    </div>

    <!-- Interactive script for audio, counters, copy-all and actions (Relative Path) -->
    <script type="module" src="../static/js/desk.js"></script>
</body>
</html>
