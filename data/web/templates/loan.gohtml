<!DOCTYPE html>
<html lang="de" translate="no" {{if and .Skin (ne .Skin "default")}}data-skin="{{.Skin}}"{{end}}>
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RFID Ausleihe &amp; Rückgabe - {{.ClientName}}</title>
    <!-- Automatic Skin & Dark / Light mode detection to prevent FOUC -->
    <script>
        (function() {
            var themeMap = {
                'default':   { light: 'corporate', dark: 'dark' },
                'emerald':   { light: 'emerald',   dark: 'emerald' },
                'nord':      { light: 'nord',      dark: 'nord' },
                'bubblegum': { light: 'cupcake',   dark: 'synthwave' }
            };
            function getSavedSkin() {
                var match = document.cookie.match(/(?:^|;\s*)rfid_skin=([^;]+)/);
                if (match) return decodeURIComponent(match[1]);
                try { return localStorage.getItem('rfid_skin'); } catch(e) { return null; }
            }
            var skin = getSavedSkin() || 'default';
            if (skin && skin !== 'default') {
                document.documentElement.setAttribute('data-skin', skin);
            } else {
                document.documentElement.removeAttribute('data-skin');
            }

            function syncTheme() {
                var isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (isDark) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.remove('light');
                } else {
                    document.documentElement.classList.add('light');
                    document.documentElement.classList.remove('dark');
                }
                var currentSkin = document.documentElement.getAttribute('data-skin') || 'default';
                var mapping = themeMap[currentSkin] || themeMap['default'];
                document.documentElement.setAttribute('data-theme', isDark ? mapping.dark : mapping.light);
            }
            syncTheme();
            if (window.matchMedia) {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);
            }
        })();
    </script>
    <!-- Tailwind CSS, DaisyUI, HTMX 4 & SSE Extension (Relative Paths) -->
    <link rel="stylesheet" href="{{.StaticPath}}/css/tailwind.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/css/daisyui.min.css">
    <script src="{{.StaticPath}}/js/htmx-4.0.js"></script>
    <script src="{{.StaticPath}}/js/hx-sse.js"></script>
    <link rel="stylesheet" href="{{.StaticPath}}/scss/desk.css">
</head>
<body class="app-body min-h-screen flex flex-col justify-between selection:bg-blue-600 selection:text-white p-4 sm:p-6 lg:p-8" sse-connect="events" data-sse-connect="events" hx-ext="sse">

    {{template "header.gohtml" .}}

    <!-- Main Content Area -->
    <main class="app-main">

        <!-- Metrics Overview Grid -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Active Media on Pad Card -->
            <div class="stats shadow-sm bg-base-100 border border-base-300/60 app-card">
                <div class="stat p-4">
                    <div class="stat-figure">
                        <div class="w-10 h-10 rounded-lg app-icon-box-emerald flex items-center justify-center">
                            <img src="{{.StaticPath}}/img/book-green.svg" class="w-5 h-5" alt="Medien" />
                        </div>
                    </div>
                    <div class="stat-title text-xs font-semibold app-metric-label">Aufliegende Medien</div>
                    <div id="stats-active-tags" class="stat-value text-2xl font-bold font-mono app-metric-val mt-1">{{len .Tags}}</div>
                </div>
            </div>

            <!-- Configured Reader Card -->
            <div class="stats shadow-sm bg-base-100 border border-base-300/60 app-card">
                <div class="stat p-4">
                    <div class="stat-figure">
                        <div class="w-10 h-10 rounded-lg app-icon-box-cyan flex items-center justify-center">
                            <img src="{{.StaticPath}}/img/chip.svg" class="w-5 h-5" alt="Reader" />
                        </div>
                    </div>
                    <div class="stat-title text-xs font-semibold app-metric-label">Konfigurierter Reader</div>
                    <div class="stat-value text-sm font-semibold font-mono app-metric-val-cyan mt-1 truncate max-w-[180px]">{{if .DefaultReader}}{{.DefaultReader}}{{else}}Automatisch / Alle{{end}}</div>
                </div>
            </div>

            <!-- Channel Card -->
            <div class="stats shadow-sm bg-base-100 border border-base-300/60 app-card">
                <div class="stat p-4">
                    <div class="stat-figure">
                        <div class="w-10 h-10 rounded-lg app-icon-box-indigo flex items-center justify-center">
                            <img src="{{.StaticPath}}/img/channel.svg" class="w-5 h-5" alt="Channel" />
                        </div>
                    </div>
                    <div class="stat-title text-xs font-semibold app-metric-label">Channel</div>
                    <div class="stat-value text-sm font-semibold font-mono app-metric-val-indigo mt-1 truncate max-w-[180px]">{{if .Channel}}{{.Channel}}{{else}}all{{end}}</div>
                </div>
            </div>
        </section>

        <!-- Active Media Table & Control Panel -->
        <section class="app-panel flex-1">
            <!-- Action Toolbar -->
            <div class="app-panel-toolbar">
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-2">
                        <h2 class="text-base font-semibold app-panel-title">Aufliegende Medien auf Reader</h2>
                        <span id="loan-tag-count-badge" class="badge badge-sm badge-outline font-mono app-count-badge">{{len .Tags}}</span>
                    </div>
                </div>

                <!-- Primary Action Buttons: Copy All ItemIDs, Entsichern, Sichern -->
                <div class="flex items-center flex-wrap gap-2">
                    <!-- Copy All Item IDs Button -->
                    <button id="btn-copy-all-itemids" type="button" class="btn btn-sm btn-ghost app-btn" title="Alle aufgelisteten Item-IDs in die Zwischenablage kopieren">
                        <img src="{{.StaticPath}}/img/copy.svg" alt="Kopieren" />
                        <span id="copy-all-label">Item-IDs kopieren</span>
                    </button>

                    <!-- Unsecure Button (AFI C2) -->
                    <button id="btn-unsecure" hx-post="loan/afi/unsecure" hx-target="#loan-table-body" hx-swap="innerHTML" type="button" class="btn btn-sm btn-outline btn-success app-btn" title="AFI auf C2 (Entsichern / Ausgeliehen / EAS deaktiviert) setzen">
                        <img src="{{.StaticPath}}/img/lock-open-emerald.svg" alt="Entsichern" />
                        <span>Entsichern</span>
                    </button>

                    <!-- Secure Button (AFI 07) -->
                    <button id="btn-secure" hx-post="loan/afi/secure" hx-target="#loan-table-body" hx-swap="innerHTML" type="button" class="btn btn-sm btn-outline btn-info app-btn" title="AFI auf 07 (Sichern / Präsenzbestand / EAS aktiv) setzen">
                        <img src="{{.StaticPath}}/img/lock-blue.svg" alt="Sichern" />
                        <span>Sichern</span>
                    </button>
                </div>
            </div>

            <!-- Status Notification Banner -->
            <div id="action-notification" class="hidden px-4 py-2 text-xs font-medium border-b transition-all flex items-center justify-between">
                <span id="action-notification-text"></span>
            </div>

            <!-- Active Tags Table with SSE Connection -->
            <div class="transponder-stream-scroll flex-1">
                <table class="table table-zebra table-pin-rows w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10 shadow-sm">
                        <tr class="text-[11px] font-semibold uppercase tracking-wider">
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Item ID (Medium)</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Transponder UID</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Teile (Multi-Part)</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Bibliothek / ISIL</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">CRC Prüfsumme</th>
                            <th scope="col" class="py-3 px-4 app-afi-status-cell">AFI Sicherheitsstatus</th>
                            <th scope="col" class="py-3 px-4 whitespace-nowrap">Aktionen</th>
                            <th scope="col" class="py-3 px-4 text-right whitespace-nowrap">Zuletzt erfasst</th>
                        </tr>
                    </thead>
                    <tbody id="loan-table-body" sse-swap="loan_tags" data-sse-swap="loan_tags" hx-swap="innerHTML">
                        {{template "loan_table.gohtml" .}}
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    {{template "footer.gohtml" .}}

    <!-- AFI Writing Modal Dialog / Waiting Overlay -->
    <dialog id="afi-modal-overlay" class="modal modal-bottom sm:modal-middle app-afi-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="afi-modal-title">
        <div class="modal-box text-center max-w-md app-afi-modal-dialog">
            <div class="mx-auto mb-4 flex items-center justify-center app-afi-spinner-container">
                <span class="loading loading-spinner loading-lg text-primary app-afi-spinner-ring"></span>
            </div>
            <h3 id="afi-modal-title" class="font-bold text-lg mb-2 app-afi-modal-title">AFI wird geschrieben...</h3>
            <p id="afi-modal-message" class="text-sm opacity-80 mb-4 app-afi-modal-desc">
                Bitte warten Sie, bis der Sicherheitsstatus auf dem Lesefeld aktualisiert wurde. Bitte keine Medien vom Lesegerät entfernen.
            </p>
            <div class="flex items-center justify-center gap-2 mb-3 app-afi-modal-badge">
                <span class="badge badge-info badge-outline gap-1 text-xs">
                    <span class="w-2 h-2 rounded-full bg-info animate-ping"></span>
                    <span id="afi-modal-status-text">RFID-Kommunikation aktiv...</span>
                </span>
            </div>
            <div id="afi-modal-timeout-hint" class="text-xs opacity-60 app-afi-modal-hint">
                Timeout-Schutz aktiv (10s)
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <!-- Interactive script for audio, counters, copy-all and actions (Relative Path) -->
    <script type="module" src="{{.StaticPath}}/js/desk.js"></script>
</body>
</html>
