<!-- DaisyUI Theme & Mode Selector Modal Dialog -->
<dialog id="theme-modal-dialog" class="modal modal-bottom sm:modal-middle" aria-labelledby="theme-modal-title" role="dialog" aria-modal="true">
    <div class="modal-box max-w-4xl max-h-[92vh] flex flex-col p-4 sm:p-6 overflow-hidden app-panel">
        
        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-3 border-b border-base-content/10 shrink-0">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-primary/15 border border-primary/25 text-primary flex items-center justify-center shrink-0 shadow-sm">
                    <span class="app-icon icon-palette w-5 h-5 text-primary" aria-hidden="true"></span>
                </div>
                <div>
                    <h3 id="theme-modal-title" class="text-base sm:text-lg font-bold app-title flex items-center gap-2">
                        Design &amp; Farbschema
                    </h3>
                    <p class="text-xs app-meta-text">Anzeigemodus und DaisyUI Theme mit Live-Vorschau anpassen</p>
                </div>
            </div>

            <!-- Close Button -->
            <button type="button" class="btn btn-sm btn-circle btn-ghost" id="theme-modal-close" aria-label="Dialog schließen" title="Schließen">
                <span class="app-icon icon-x-mark w-4 h-4" aria-hidden="true"></span>
            </button>
        </div>

        <!-- Mode & Filter Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-3 py-3 border-b border-base-content/10 shrink-0">
            <!-- Mode Radios -->
            <div class="flex items-center gap-2">
                <span class="text-xs font-semibold uppercase tracking-wider app-metric-label">Modus:</span>
                <div class="join" id="theme-mode-radios" role="radiogroup" aria-label="Anzeigemodus auswählen">
                    <button type="button" data-mode="auto" id="theme-mode-btn-auto" class="btn btn-xs sm:btn-sm join-item theme-mode-btn btn-primary app-btn flex items-center gap-1.5" role="radio" aria-checked="true" title="Folgt den Systemeinstellungen des Betriebssystems">
                        <span class="app-icon icon-sun-moon w-3.5 h-3.5 shrink-0" aria-hidden="true"></span>
                        <span>Auto</span>
                    </button>
                    <button type="button" data-mode="lightmode" id="theme-mode-btn-light" class="btn btn-xs sm:btn-sm join-item theme-mode-btn btn-ghost app-btn flex items-center gap-1.5" role="radio" aria-checked="false" title="Immer helles Farbschema erzwingen">
                        <span class="app-icon icon-sun-moon w-3.5 h-3.5 shrink-0" aria-hidden="true"></span>
                        <span>Hell</span>
                    </button>
                    <button type="button" data-mode="darkmode" id="theme-mode-btn-dark" class="btn btn-xs sm:btn-sm join-item theme-mode-btn btn-ghost app-btn flex items-center gap-1.5" role="radio" aria-checked="false" title="Immer dunkles Farbschema erzwingen">
                        <span class="app-icon icon-sun-moon w-3.5 h-3.5 shrink-0" aria-hidden="true"></span>
                        <span>Dunkel</span>
                    </button>
                </div>
            </div>

            <!-- Filter Tabs & Search -->
            <div class="flex items-center gap-2">
                <div class="join" id="theme-filter-tabs">
                    <button type="button" data-filter="all" class="btn btn-xs join-item theme-filter-btn btn-primary app-btn">Alle (<span id="theme-count-all">26</span>)</button>
                    <button type="button" data-filter="light" class="btn btn-xs join-item theme-filter-btn btn-ghost app-btn">Hell (<span id="theme-count-light">14</span>)</button>
                    <button type="button" data-filter="dark" class="btn btn-xs join-item theme-filter-btn btn-ghost app-btn">Dunkel (<span id="theme-count-dark">12</span>)</button>
                </div>
                <div class="relative flex items-center">
                    <input type="text" id="theme-search-input" placeholder="Theme suchen..." class="input input-xs input-bordered w-28 sm:w-36 font-mono app-input pl-6" />
                    <span class="app-icon icon-search w-3 h-3 text-base-content/50 absolute left-2 pointer-events-none" aria-hidden="true"></span>
                </div>
            </div>
        </div>

        <!-- Scrollable Content: Live-Test Preview & Themes Grid -->
        <div class="flex-1 overflow-y-auto space-y-4 py-3 pr-1 transponder-stream-scroll">
            
            <!-- Interactive Live-Test Preview Component (DaisyUI Components Sample) -->
            <div id="theme-live-preview-box" class="card card-bordered bg-base-100/90 shadow-sm p-3.5 sm:p-4 border-base-300 transition-all">
                <div class="flex items-center justify-between mb-3 border-b border-base-content/10 pb-2">
                    <div class="flex items-center gap-2">
                        <span class="badge badge-sm badge-primary font-mono text-[10px]">LIVE TEST</span>
                        <span class="text-xs font-bold text-base-content">
                            Aktives Theme: <strong id="live-preview-theme-title" class="text-primary font-mono text-sm">Corporate</strong>
                        </span>
                    </div>
                    <span class="text-[11px] app-meta-text hidden sm:inline">Interaktive Vorschau &amp; Klicktest</span>
                </div>
                
                <!-- Buttons Row -->
                <div class="flex flex-wrap items-center gap-1.5 mb-2.5">
                    <button type="button" class="btn btn-xs sm:btn-sm btn-primary">Primary</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-secondary">Secondary</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-accent">Accent</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-neutral">Neutral</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-ghost">Ghost</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-outline btn-primary">Outline</button>
                </div>

                <!-- Badges Row -->
                <div class="flex flex-wrap items-center gap-1.5 mb-3">
                    <span class="badge badge-primary badge-sm">Primary</span>
                    <span class="badge badge-secondary badge-sm">Secondary</span>
                    <span class="badge badge-accent badge-sm">Accent</span>
                    <span class="badge badge-success badge-sm">Erfolg</span>
                    <span class="badge badge-warning badge-sm">Warnung</span>
                    <span class="badge badge-error badge-sm">Fehler</span>
                    <span class="badge badge-info badge-sm">Info</span>
                    <span class="badge badge-outline badge-sm font-mono">CH-000001</span>
                </div>

                <!-- Form Controls Row -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 items-center bg-base-200/60 p-2.5 rounded-lg border border-base-content/10">
                    <div class="flex items-center gap-2">
                        <input type="text" class="input input-xs input-bordered w-full font-mono text-[11px] app-input" value="ITEM-987654 (Live-Test)" readonly />
                    </div>
                    <div class="flex items-center justify-around gap-2">
                        <label class="label cursor-pointer gap-1.5 py-0 select-none">
                            <input type="checkbox" class="checkbox checkbox-primary checkbox-xs" checked />
                            <span class="label-text text-xs">AFI 07</span>
                        </label>
                        <label class="label cursor-pointer gap-1.5 py-0 select-none">
                            <input type="checkbox" class="toggle toggle-secondary toggle-xs" checked />
                            <span class="label-text text-xs">Ton</span>
                        </label>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] text-base-content/70 font-mono">Level:</span>
                        <input type="range" min="0" max="100" value="75" class="range range-xs range-accent flex-1" />
                    </div>
                </div>
            </div>

            <!-- Themes Grid Section -->
            <div>
                <div class="flex items-center justify-between mb-2">
                    <h4 class="text-xs font-bold uppercase tracking-wider app-meta-text">Verfügbare DaisyUI Themes</h4>
                    <span class="text-[11px] app-meta-text">Klicken zum sofortigen Testen &amp; Auswählen</span>
                </div>
                
                <div id="theme-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
                    <!-- Populated dynamically by theme-selector.js -->
                </div>
            </div>

        </div>

        <!-- Modal Footer -->
        <div class="modal-action flex items-center justify-between pt-3 border-t border-base-content/10 mt-3 shrink-0">
            <button type="button" id="theme-reset-btn" class="btn btn-sm btn-ghost app-btn text-xs text-base-content/70 hover:text-base-content" title="Auf Standard-Design (Corporate / Dark) zurücksetzen">
                Standard wiederherstellen
            </button>
            <button type="button" id="theme-apply-close-btn" class="btn btn-sm btn-primary app-btn text-xs font-semibold px-5" title="Auswahl übernehmen und Dialog schließen">
                Fertig
            </button>
        </div>

    </div>
    
    <!-- Modal Backdrop -->
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>
