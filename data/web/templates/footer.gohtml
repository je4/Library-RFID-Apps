<!-- Footer Bar -->
<footer class="footer w-full max-w-7xl mx-auto mt-6 bg-base-100 border border-base-200 shadow-sm rounded-2xl px-5 sm:px-6 py-3.5 sm:py-4 text-base-content/80 flex flex-wrap justify-between items-center text-xs gap-4">
    <div>
        RFID Desk &copy; 2026 info-age GmbH, Basel
    </div>
    <div class="flex items-center space-x-4 font-mono">
        <span>{{tr "reader.webserver"}} <span class="server-addr">{{.Addr}}</span></span>
        <span id="ws-activity-bullet" class="ws-activity-bullet" title="{{tr "websocket.activity"}}" aria-label="{{tr "websocket.activity"}}">&bull;</span>
        <span>{{tr "reader.broker"}} <span class="broker-addr">{{.WSBroker}}</span></span>
    </div>
</footer>
