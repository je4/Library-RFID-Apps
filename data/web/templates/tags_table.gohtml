{{if .Tags}}
    {{range .Tags}}
        {{template "tag_row.gohtml" .}}
    {{end}}
{{else}}
    <tr id="no-tags-row">
        <td colspan="8" class="py-12 text-center">
            <div class="flex flex-col items-center justify-center space-y-2">
                <img src="{{.StaticPath}}/img/empty-tags.svg" class="w-10 h-10 app-empty-icon animate-pulse" alt="Keine Tags" />
                <p class="text-sm font-medium app-empty-title">Noch keine RFID-Tags gescannt</p>
                <p class="text-xs app-empty-desc">Halten Sie ein Medium an das Lesegerät, um den Scan-Stream zu empfangen.</p>
            </div>
        </td>
    </tr>
{{end}}
