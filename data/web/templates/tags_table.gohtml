{{if .Tags}}
    {{range .Tags}}
        {{template "tag_row.gohtml" .}}
    {{end}}
{{else}}
    <tr id="no-tags-row">
        <td colspan="7" class="py-12 text-center text-gray-500">
            <div class="flex flex-col items-center justify-center space-y-2">
                <svg class="w-10 h-10 text-gray-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                </svg>
                <p class="text-sm font-medium text-gray-400">Noch keine RFID-Tags gescannt</p>
                <p class="text-xs text-gray-500">Halten Sie ein Medium an das Lesegerät, um den Scan-Stream zu empfangen.</p>
            </div>
        </td>
    </tr>
{{end}}
