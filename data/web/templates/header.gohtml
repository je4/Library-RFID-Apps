                <li>
                    <label class="btn btn-sm btn-block btn-ghost justify-between font-normal flex items-center px-2 py-1.5 cursor-pointer rounded-lg hover:bg-base-300/80">
                        <div class="flex items-center gap-2.5">
                            <span data-theme="corporate" class="bg-base-100 rounded-md flex gap-0.5 p-1 border border-base-content/10 shadow-xs shrink-0">
