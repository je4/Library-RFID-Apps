                        <div class="flex items-center gap-1.5">
                            <span class="theme-check-icon hidden text-primary font-bold text-xs" aria-hidden="true">✓</span>
                            <input type="radio" name="theme-dropdown" class="theme-controller hidden" value="retro" aria-label="retro" />
