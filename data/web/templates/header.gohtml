<!-- Header Bar with Navigation -->
<header class="navbar w-full max-w-7xl mx-auto flex flex-wrap items-center justify-between mb-4 bg-base-100 border border-base-200 shadow-sm rounded-2xl px-4 sm:px-5 py-2.5 sm:py-3 gap-3 min-h-0 text-base-content relative z-30">
    <div class="flex items-center space-x-3.5">
        <!-- Dynamisches Icon & Gradient -->
        <div class="w-11 h-11 rounded-xl bg-primary text-primary-content flex items-center justify-center shadow-lg shadow-primary/25 shrink-0">
            <img src="{{.StaticPath}}/img/icons/{{if .IsLoan}}book-open.svg{{else if .IsEncode}}tag.svg{{else}}bolt.svg{{end}}" class="w-6 h-6 brightness-0 invert" alt="{{if .IsLoan}}Ausleihe{{else if .IsEncode}}Medium kodieren{{else}}RFID Desk{{end}}" />
        </div>

        <div>
            <!-- Breadcrumbs Navigation -->
            {{if .Channel}}
            <nav class="breadcrumbs text-xs text-base-content/70 py-0 mb-0.5" aria-label="Breadcrumb-Navigation">
                <ul>
                    <li>
                        <a href="../" id="nav-channels-btn" class="inline-flex items-center gap-1 hover:text-primary transition-colors font-medium" title="Zur Channel-Auswahl">
                            <span class="app-icon icon-channel w-3 h-3 shrink-0" aria-hidden="true"></span>
                            <span>Channels</span>
                        </a>
                    </li>
                    <li>
                        {{if or .IsLoan .IsEncode}}
                        <a href="./" id="nav-channel-btn" class="inline-flex items-center gap-1 hover:text-primary transition-colors font-medium" title="Zum Channel {{.Channel}} (Desk)">
                            <span class="app-icon icon-channel w-3 h-3 shrink-0" aria-hidden="true"></span>
                            <span>{{.Channel}}</span>
                        </a>
                        {{else}}
                        <span class="inline-flex items-center gap-1 font-medium text-base-content/80">
                            <span class="app-icon icon-channel w-3 h-3 shrink-0" aria-hidden="true"></span>
                            <span>{{.Channel}}</span>
                        </span>
                        {{end}}
                    </li>
                    <li class="font-semibold text-base-content">
                        <span class="inline-flex items-center gap-1">
                            <span class="app-icon {{if .IsLoan}}icon-book-open{{else if .IsEncode}}icon-tag{{else}}icon-home{{end}} w-3 h-3 shrink-0" aria-hidden="true"></span>
                            <span>{{if .IsLoan}}Ausleihe &amp; Rückgabe{{else if .IsEncode}}Medium kodieren{{else}}Desk{{end}}</span>
                        </span>
                    </li>
                </ul>
            </nav>
            {{end}}

            <!-- Titel & Status Badge -->
            <h1 class="text-xl font-bold tracking-tight flex items-center gap-2.5">
                {{if .IsLoan}}Ausleihe &amp; Rückgabe{{else if .IsEncode}}Medium kodieren{{else}}RFID Desk{{end}}
                {{if .Channel}}
                <span id="field-status-badge" class="badge badge-sm badge-outline transition-all">Bereit</span>
                {{else}}
                <span class="badge badge-sm badge-outline transition-all">Channel-Auswahl</span>
                {{end}}
            </h1>

            <!-- Metadaten-Zeile -->
            <p class="text-xs text-base-content/80 font-mono flex items-center gap-2 mt-0.5">
                {{if .Channel}}<span>Channel: <strong>{{.Channel}}</strong></span><span>&bull;</span>{{end}}
                {{if not (or .IsLoan .IsEncode)}}
                <span>Broker: <strong>{{.WSBroker}}</strong></span>
                <span>&bull;</span>
                {{end}}
                <span>Client: <strong>{{.ClientName}}</strong></span>
            </p>
        </div>
    </div>

    <!-- Top Right Actions & Theme Selector -->
    <div class="flex items-center space-x-3">
        {{if .HasExplicitThemes}}
        <!-- Auto / Light / Dark Mode Switcher (Explicit Themes Configured) -->
        <div class="dropdown dropdown-end" id="theme-mode-dropdown">
            <div tabindex="0" role="button" id="theme-mode-btn" class="btn btn-sm btn-ghost flex items-center gap-1.5" title="Farbschema anpassen (Auto / Hell / Dunkel)" aria-label="Farbschema Modus" aria-haspopup="true">
                <span class="app-icon icon-sun-moon w-4 h-4 shrink-0" aria-hidden="true"></span>
                <span class="hidden sm:inline text-xs font-semibold">Modus</span>
                <span id="theme-mode-indicator" class="badge badge-xs badge-primary font-mono text-[10px]">{{if .ThemeMode}}{{.ThemeMode}}{{else}}auto{{end}}</span>
                <svg class="w-3.5 h-3.5 opacity-60 inline-block fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2048 2048"><path d="M1799 647l-775 775L249 647l64-64 711 711 711-711z"/></svg>
            </div>
            <ul tabindex="0" class="dropdown-content menu bg-base-200 text-base-content rounded-2xl z-50 w-52 p-2 shadow-2xl border border-base-300 space-y-1" id="theme-mode-menu">
                <li class="menu-title text-xs font-bold px-2 py-1.5 opacity-70">Farbschema</li>
                <li>
                    <label class="btn btn-sm btn-block btn-ghost justify-between font-normal flex items-center px-2 py-1.5 cursor-pointer rounded-lg hover:bg-base-300/80">
                        <div class="flex items-center gap-2">
                            <span class="app-icon icon-sun-moon w-4 h-4 shrink-0"></span>
                            <span class="text-xs font-medium">Automatisch</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="theme-mode-check hidden text-primary font-bold text-xs" aria-hidden="true">✓</span>
                            <input type="radio" name="theme-mode-switch" class="theme-mode-controller hidden" value="auto" aria-label="Automatisch" />
                        </div>
                    </label>
                </li>
                <li>
                    <label class="btn btn-sm btn-block btn-ghost justify-between font-normal flex items-center px-2 py-1.5 cursor-pointer rounded-lg hover:bg-base-300/80">
                        <div class="flex items-center gap-2">
                            <span data-theme="{{.ThemeLight}}" class="bg-base-100 rounded-md flex gap-0.5 p-1 border border-base-content/10 shadow-xs shrink-0">
                                <span class="w-1.5 h-3.5 rounded-full bg-primary inline-block"></span>
                                <span class="w-1.5 h-3.5 rounded-full bg-secondary inline-block"></span>
                            </span>
                            <span class="text-xs font-medium">Hell</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="theme-mode-check hidden text-primary font-bold text-xs" aria-hidden="true">✓</span>
                            <input type="radio" name="theme-mode-switch" class="theme-mode-controller hidden" value="light" aria-label="Hell" />
                        </div>
                    </label>
                </li>
                <li>
                    <label class="btn btn-sm btn-block btn-ghost justify-between font-normal flex items-center px-2 py-1.5 cursor-pointer rounded-lg hover:bg-base-300/80">
                        <div class="flex items-center gap-2">
                            <span data-theme="{{.ThemeDark}}" class="bg-base-100 rounded-md flex gap-0.5 p-1 border border-base-content/10 shadow-xs shrink-0">
                                <span class="w-1.5 h-3.5 rounded-full bg-primary inline-block"></span>
                                <span class="w-1.5 h-3.5 rounded-full bg-secondary inline-block"></span>
                            </span>
                            <span class="text-xs font-medium">Dunkel</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="theme-mode-check hidden text-primary font-bold text-xs" aria-hidden="true">✓</span>
                            <input type="radio" name="theme-mode-switch" class="theme-mode-controller hidden" value="dark" aria-label="Dunkel" />
                        </div>
                    </label>
                </li>
            </ul>
        </div>
        {{else}}
        <!-- DaisyUI Theme Controller Dropdown -->
        <div class="dropdown dropdown-end" id="theme-dropdown">
            <div tabindex="0" role="button" id="theme-dialog-btn" class="btn btn-sm btn-ghost flex items-center gap-1.5" title="Design &amp; Farbschema anpassen (DaisyUI Theme Controller)" aria-label="Theme Controller" aria-haspopup="true">
                <span class="app-icon icon-palette w-4 h-4 shrink-0" aria-hidden="true"></span>
                <span class="hidden sm:inline text-xs font-semibold">Theme</span>
                <span id="theme-name-indicator" class="badge badge-xs badge-primary font-mono text-[10px]">corporate</span>
                <svg class="w-3.5 h-3.5 opacity-60 inline-block fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2048 2048"><path d="M1799 647l-775 775L249 647l64-64 711 711 711-711z"/></svg>
            </div>
            <ul tabindex="0" class="dropdown-content menu bg-base-200 text-base-content rounded-2xl z-50 w-60 p-2 shadow-2xl max-h-[75vh] overflow-y-auto border border-base-300 space-y-1 transponder-stream-scroll" id="theme-dropdown-menu">
                <li class="menu-title text-xs font-bold px-2 py-1.5 opacity-70">Farbpalette</li>
                <!-- University of Basel Custom Theme Items -->
                <li>
                    <label class="btn btn-sm btn-block btn-ghost justify-between font-normal flex items-center px-2 py-1.5 cursor-pointer rounded-lg hover:bg-base-300/80">
                        <div class="flex items-center gap-2.5">
                            <span data-theme="unibas-light" class="bg-base-100 rounded-md flex gap-0.5 p-1 border border-base-content/10 shadow-xs shrink-0">
                                <span class="w-1.5 h-3.5 rounded-full bg-primary inline-block"></span>
                                <span class="w-1.5 h-3.5 rounded-full bg-secondary inline-block"></span>
                                <span class="w-1.5 h-3.5 rounded-full bg-accent inline-block"></span>
                                <span class="w-1.5 h-3.5 rounded-full bg-neutral inline-block"></span>
                            </span>
                            <span class="text-xs font-semibold">unibas-light</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="theme-check-icon hidden text-primary font-bold text-xs" aria-hidden="true">✓</span>
                            <input type="radio" name="theme-dropdown" class="theme-controller hidden" value="unibas-light" aria-label="unibas-light" />
                        </div>
                    </label>
