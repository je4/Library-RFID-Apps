        {{end}}

        {{if .Channel}}
        <!-- Audio Feedback Toggle Button -->
        <button id="sound-toggle" type="button" class="btn btn-sm btn-ghost flex items-center gap-1.5" title="Signalton einschalten" aria-pressed="false">
            <span class="app-icon icon-volume-off w-3.5 h-3.5 shrink-0 sound-icon-off" aria-hidden="true"></span>
            <span class="app-icon icon-volume-high w-3.5 h-3.5 shrink-0 sound-icon-on hidden" aria-hidden="true"></span>
            <span>Ton</span>
            <span class="sound-toggle-indicator w-2 h-2 rounded-full shrink-0 block bg-base-content/30"></span>
        </button>

        <!-- SSE Status Badge -->
        <div id="sse-status-container" class="badge badge-sm badge-outline gap-2 px-3 py-2.5">
            <span id="sse-status-dot" class="w-2 h-2 rounded-full bg-warning"></span>
            <span id="sse-status-text" class="font-medium">Verbinde SSE...</span>
        </div>
        {{end}}
    </div>
</header>
