<!DOCTYPE html>
<html lang="de" translate="no"{{if .Theme}} data-theme="{{.Theme}}"{{end}}{{if .ThemeMode}} data-theme-mode="{{.ThemeMode}}"{{end}}{{if .ThemeLight}} data-theme-light="{{.ThemeLight}}"{{end}}{{if .ThemeDark}} data-theme-dark="{{.ThemeDark}}"{{end}}>
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RFID Inventur - {{.ClientName}}</title>
    <!-- Automatic Skin & Dark / Light mode detection to prevent FOUC -->
    <script src="{{.StaticPath}}/js/theme-init.js"></script>
    <!-- Tailwind CSS, DaisyUI, HTMX 4 & SSE Extension (Relative Paths) -->
    <link rel="stylesheet" href="{{.StaticPath}}/css/tailwind.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/css/daisyui.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/css/daisyui-themes.min.css">
    <script src="{{.StaticPath}}/js/htmx-4.0.js"></script>
    <script src="{{.StaticPath}}/js/hx-sse.js"></script>
    <link rel="stylesheet" href="{{.StaticPath}}/scss/desk.css">
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-primary selection:text-primary-content p-4 sm:p-6 lg:p-8" sse-connect="events" data-sse-connect="events" hx-ext="sse">

    {{template "header.gohtml" .}}

    <!-- Main Content Area -->
    <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col gap-4">

        {{template "nav_tabs.gohtml" .}}

        <!-- Session & Location Marker Management Header Card -->
        <section class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 sm:p-5">
            <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
                <!-- Location / Shelf Marker Input (Continuous Sync) -->
                <div class="flex-1 flex flex-wrap sm:flex-nowrap items-center gap-2.5">
                    <div class="flex items-center gap-2 text-sm font-semibold shrink-0 text-base-content/80">
                        <span class="app-icon icon-archive w-4 h-4 text-primary" aria-hidden="true"></span>
                        <label for="inv-marker-input">Standort / Regal-Marker:</label>
                    </div>
                    <div class="w-full sm:w-auto flex-1 max-w-md">
                        <input id="inv-marker-input"
                               name="marker"
                               type="text"
                               value="{{.Marker}}"
                               placeholder="z. B. EG-R04-F02 oder Signatur"
                               hx-post="inventory/marker"
                               hx-trigger="input changed delay:300ms, change"
                               hx-swap="none"
                               autocomplete="off"
                               class="input input-sm input-bordered font-mono font-bold w-full text-sm focus:input-primary">
                    </div>
                </div>

                <!-- Session Controls -->
                <div class="flex flex-wrap items-center gap-2">
                    <!-- Session Status Indicator -->
                    <div id="session-status-badge" class="badge badge-sm {{if and .SessionActive (not .IsPaused)}}badge-success{{else if .IsPaused}}badge-warning{{else}}badge-ghost{{end}} font-mono font-bold gap-1 px-2.5 py-3">
                        <span id="session-status-dot" class="w-2 h-2 rounded-full {{if and .SessionActive (not .IsPaused)}}bg-success-content animate-pulse{{else if .IsPaused}}bg-warning-content{{else}}bg-base-content/40{{end}}" aria-hidden="true"></span>
                        <span id="session-status-label">{{if and .SessionActive (not .IsPaused)}}Aktiv{{else if .IsPaused}}Pausiert{{else}}Inaktiv{{end}}</span>
                    </div>

                    <!-- Start / Update Session Button -->
                    <button id="btn-inv-start"
                            hx-post="inventory/session"
                            hx-include="#inv-marker-input"
                            hx-target="#inventory-table-body"
                            hx-swap="innerHTML"
                            type="button"
                            class="btn btn-sm {{if .SessionActive}}btn-outline{{else}}btn-primary shadow-sm{{end}} gap-1.5"
                            title="Inventur mit aktuellem Marker starten"
                            {{if not .Marker}}disabled{{end}}>
                        <span class="app-icon icon-play w-3.5 h-3.5" aria-hidden="true"></span>
                        <span id="btn-inv-start-label">{{if .SessionActive}}Neustart{{else}}Inventur starten{{end}}</span>
                    </button>

                    <!-- Pause / Resume Button -->
                    <button id="btn-inv-pause"
                            hx-post="{{if .IsPaused}}inventory/resume{{else}}inventory/pause{{end}}"
                            hx-swap="none"
                            type="button"
                            class="btn btn-sm btn-outline border-base-200 gap-1.5"
                            title="Erfassung vorübergehend pausieren oder fortsetzen (Leertaste)">
                        <span id="btn-inv-pause-icon" class="app-icon {{if .IsPaused}}icon-play{{else}}icon-pause{{end}} w-3.5 h-3.5" aria-hidden="true"></span>
                        <span id="btn-inv-pause-label">{{if .IsPaused}}Fortsetzen{{else}}Pausieren{{end}}</span>
                    </button>

                    <!-- Reset Session Button -->
                    <button id="btn-inv-reset"
                            hx-post="inventory/reset"
                            hx-target="#inventory-table-body"
                            hx-swap="innerHTML"
                            type="button"
                            class="btn btn-sm btn-ghost text-error hover:bg-error hover:text-error-content gap-1.5"
                            title="Aktuelle Sitzung und Zähler zurücksetzen">
                        <span class="app-icon icon-trash w-3.5 h-3.5" aria-hidden="true"></span>
                        <span>Zurücksetzen</span>
                    </button>

                    <!-- Acoustic Feedback Toggle Button -->
                    <button id="btn-inv-sound"
                            type="button"
                            class="btn btn-sm btn-ghost border border-base-200 gap-1 text-base-content/80"
                            title="Akustisches Feedback (Audio Cues) umschalten">
                        <span id="icon-sound-state" class="app-icon icon-volume-2 w-3.5 h-3.5 text-success" aria-hidden="true"></span>
                        <span id="sound-state-label" class="text-xs">Ton an</span>
                    </button>
                </div>
            </div>

            <!-- Webservice Info Bar -->
            {{if .InventoryConf}}
            {{if .InventoryConf.Webservice.TargetURL}}
            <div class="mt-3 pt-3 border-t border-base-200/60 flex flex-wrap items-center justify-between text-xs text-base-content/60 font-mono gap-2">
                <div class="flex items-center gap-2 truncate max-w-2xl">
                    <span class="badge badge-xs badge-info font-bold uppercase">{{.InventoryConf.Webservice.HTTPMethod}}</span>
                    <span class="truncate" title="{{.InventoryConf.Webservice.TargetURL}}">Ziel: <strong>{{.InventoryConf.Webservice.TargetURL}}</strong></span>
                </div>
                <div class="flex items-center gap-3">
                    {{if .InventoryConf.Webservice.ClientID}}
                    <span>Station: <strong class="text-base-content/80">{{.InventoryConf.Webservice.ClientID}}</strong></span>
                    {{end}}
                    {{if .InventoryConf.Webservice.JWTKey}}
                    <span class="badge badge-xs badge-success gap-1 font-semibold" title="HMAC-SHA256 JWT Authentifizierung aktiv">
                        <span class="w-1.5 h-1.5 rounded-full bg-success-content" aria-hidden="true"></span>
                        JWT Auth
                    </span>
                    {{end}}
                </div>
            </div>
            {{end}}
            {{end}}
        </section>

        <!-- KPI Metrics Summary Stats Box -->
        <section class="stats stats-vertical sm:stats-horizontal border border-base-200 bg-base-100 shadow-sm w-full rounded-2xl" aria-label="Inventur Kennzahlen">
            <!-- Stat 1: Total Scans -->
            <div class="stat py-3.5 px-4 sm:px-6">
                <div class="stat-figure text-base-content/30">
                    <span class="app-icon icon-refresh w-5 h-5" aria-hidden="true"></span>
                </div>
                <div class="stat-title text-xs font-medium text-base-content/60">Gesamterfassungen</div>
                <div id="kpi-total-scans" class="stat-value text-2xl font-mono text-base-content">{{.TotalScans}}</div>
            </div>

            <!-- Stat 2: Unique Items -->
            <div class="stat py-3.5 px-4 sm:px-6">
                <div class="stat-figure text-success/50">
                    <span class="app-icon icon-check w-5 h-5 text-success" aria-hidden="true"></span>
                </div>
                <div class="stat-title text-xs font-medium text-success">Eindeutige Medien</div>
                <div id="kpi-unique-items" class="stat-value text-2xl font-mono text-success">{{.UniqueItems}}</div>
            </div>

            <!-- Stat 3: Error / Empty Tags -->
            <div class="stat py-3.5 px-4 sm:px-6">
                <div class="stat-figure text-error/50">
                    <span class="app-icon icon-alert w-5 h-5 text-error" aria-hidden="true"></span>
                </div>
                <div class="stat-title text-xs font-medium text-error">Fehler / Leer</div>
                <div id="kpi-error-tags" class="stat-value text-2xl font-mono text-error">{{.ErrorTags}}</div>
            </div>

            <!-- Stat 4: Duplicate Tags -->
            <div class="stat py-3.5 px-4 sm:px-6">
                <div class="stat-figure text-warning/50">
                    <span class="app-icon icon-copy w-5 h-5 text-warning" aria-hidden="true"></span>
                </div>
                <div class="stat-title text-xs font-medium text-warning">Dubletten</div>
                <div id="kpi-duplicate-tags" class="stat-value text-2xl font-mono text-warning">{{.DuplicateTags}}</div>
            </div>

            <!-- Stat 5: Last Scanned Item -->
            <div class="stat py-3.5 px-4 sm:px-6">
                <div class="stat-title text-xs font-medium text-base-content/60">Letztes Medium</div>
                <div id="kpi-last-item" class="mt-1 truncate">
                    {{if .LastItem}}
                        <div class="font-mono font-bold text-sm text-primary truncate">{{if .LastItem.ItemID}}{{.LastItem.ItemID}}{{else}}{{.LastItem.UID}}{{end}}</div>
                        <div class="text-[11px] text-base-content/60 truncate">{{if .LastItem.ISILName}}{{.LastItem.ISILName}}{{else}}Erfasst{{end}}</div>
                    {{else}}
                        <span class="text-xs text-base-content/40 italic">Noch kein Scan</span>
                    {{end}}
                </div>
            </div>
        </section>

        <!-- Webservice Alert Banner (Dynamic) -->
        <div id="webservice-alert-container" class="hidden transition-all duration-300">
            <div class="alert alert-error shadow-sm rounded-xl py-2.5 px-4 text-xs flex items-center justify-between">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="app-icon icon-alert w-4 h-4 shrink-0 text-error-content" aria-hidden="true"></span>
                    <span id="webservice-alert-text" class="font-medium text-error-content truncate"></span>
                </div>
                <button type="button" class="btn btn-ghost btn-xs btn-circle text-error-content hover:bg-error-content/20" onclick="document.getElementById('webservice-alert-container').classList.add('hidden')">✕</button>
            </div>
        </div>

        <!-- Live Inventory Items Table Card -->
        <section class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl overflow-hidden flex-1 flex flex-col">
            <!-- Table Toolbar -->
            <div class="px-5 sm:px-6 py-3.5 sm:py-4 border-b border-base-200 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <h2 class="text-base font-semibold">Erfasste Medien dieser Sitzung</h2>
                    <span id="inv-table-count" class="badge badge-sm badge-outline font-mono">{{len .Items}}</span>
                </div>

                <div class="flex items-center space-x-2.5">
                    <!-- Filter Input -->
                    <div class="relative flex items-center">
                        <input id="inv-filter-input" type="text" placeholder="Filtern (F2 / Esc)..." class="input input-sm input-bordered pl-8 pr-12 w-48 sm:w-64 font-mono text-xs">
                        <span class="app-icon icon-search w-3.5 h-3.5 text-base-content/50 absolute left-2.5 pointer-events-none" aria-hidden="true"></span>
                        <kbd class="kbd kbd-xs bg-base-200 text-base-content/60 absolute right-2 pointer-events-none">F2</kbd>
                    </div>
                </div>
            </div>

            <!-- Table Container -->
            <div class="transponder-stream-scroll flex-1 overflow-x-auto">
                <table class="table table-zebra table-pin-rows w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10 bg-base-200 text-base-content/80 font-bold">
                        <tr class="text-[11px] font-semibold uppercase tracking-wider text-base-content/70">
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">Barcode / Item ID</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">Transponder UID</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">Standort / Marker</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">Bibliothek / ISIL</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">Teil</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">AFI</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">Webservice Status</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 text-right whitespace-nowrap">Zeitstempel</th>
                        </tr>
                    </thead>
                    <tbody id="inventory-table-body">
                        {{template "inventory_table.gohtml" .}}
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    {{template "footer.gohtml" .}}

    <!-- Web Audio API and Interactive Inventory Controller Script -->
    <script>
        (function() {
            // Web Audio API Acoustic Feedback Engine
            let audioCtx = null;
            let soundEnabled = true;

            function getAudioContext() {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (AudioContextClass) {
                        audioCtx = new AudioContextClass();
                    }
                }
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume().catch(() => {});
                }
                return audioCtx;
            }

            function playTone(freq, type, duration, gainLevel, startTimeOffset = 0) {
                if (!soundEnabled) return;
                const ctx = getAudioContext();
                if (!ctx) return;

                try {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    const now = ctx.currentTime + startTimeOffset;

                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, now);

                    gain.gain.setValueAtTime(gainLevel, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    osc.start(now);
                    osc.stop(now + duration);
                } catch (e) {
                    console.warn("Audio cue error:", e);
                }
            }

            // High positive double chime for successful scan
            function playSuccessCue() {
                playTone(980, 'sine', 0.08, 0.25, 0);
                playTone(1480, 'sine', 0.12, 0.20, 0.06);
            }

            // Muted gentle tone for duplicate tag
            function playDuplicateCue() {
                playTone(440, 'triangle', 0.12, 0.20, 0);
            }

            // Distinct low double beep for error/empty tag or failed webservice call
            function playErrorCue() {
                playTone(220, 'sawtooth', 0.10, 0.25, 0);
                playTone(180, 'sawtooth', 0.14, 0.25, 0.12);
            }

            // Sound Toggle UI
            const btnSound = document.getElementById('btn-inv-sound');
            const iconSound = document.getElementById('icon-sound-state');
            const labelSound = document.getElementById('sound-state-label');

            if (btnSound) {
                btnSound.addEventListener('click', function() {
                    soundEnabled = !soundEnabled;
                    if (soundEnabled) {
                        iconSound.className = 'app-icon icon-volume-2 w-3.5 h-3.5 text-success';
                        labelSound.textContent = 'Ton an';
                        playTone(1000, 'sine', 0.05, 0.15);
                    } else {
                        iconSound.className = 'app-icon icon-volume-x w-3.5 h-3.5 text-base-content/40';
                        labelSound.textContent = 'Ton aus';
                    }
                });
            }

            // Resume audio context on first user interaction
            document.addEventListener('click', function() {
                getAudioContext();
            }, { once: true });

            // SSE Event Listener for Inventory Tag Reads and KPI Stats
            let lastHandledInvEventKey = null;
            let lastHandledInvTimestamp = 0;

            function handleSSEEvent(e) {
                const eventType = e.detail ? (e.detail.eventName || e.detail.type || e.type) : (e.type || '');
                const rawData = e.detail ? (e.detail.data !== undefined ? e.detail.data : e.data) : (e.data || '');
                if (!eventType || !rawData) return;

                if (eventType === 'inventory_tag') {
                    try {
                        const payload = typeof rawData === 'string' ? JSON.parse(rawData) : rawData;

                        // Deduplicate event processing if identical message received within 100ms
                        const now = Date.now();
                        const eventKey = typeof rawData === 'string' ? rawData : JSON.stringify(rawData);
                        if (eventKey === lastHandledInvEventKey && (now - lastHandledInvTimestamp) < 100) {
                            return;
                        }
                        lastHandledInvEventKey = eventKey;
                        lastHandledInvTimestamp = now;

                        if (payload.audio === 'success') {
                            playSuccessCue();
                        } else if (payload.audio === 'duplicate') {
                            playDuplicateCue();
                        } else if (payload.audio === 'error') {
                            playErrorCue();
                        }

                        // Insert or replace rendered HTML row if present
                        if (payload.htmlRow) {
                            const tbody = document.getElementById('inventory-table-body');
                            if (tbody) {
                                // Remove any empty placeholder row
                                const emptyRows = tbody.querySelectorAll('#inventory-empty-row, tr:not([id^="inv-row-"])');
                                emptyRows.forEach(el => el.remove());

                                const uid = payload.item ? (payload.item.uid || payload.item.id || payload.item.UID) : null;
                                const existingRow = uid ? document.getElementById('inv-row-' + uid) : null;
                                if (existingRow) {
                                    existingRow.outerHTML = payload.htmlRow;
                                } else {
                                    tbody.insertAdjacentHTML('afterbegin', payload.htmlRow);
                                }
                                if (window.htmx) {
                                    window.htmx.process(tbody);
                                }
                                applyFilter();
                            }
                        }

                        // Update Last Item Card
                        if (payload.item) {
                            const lastCard = document.getElementById('kpi-last-item');
                            if (lastCard) {
                                const label = payload.item.itemId || payload.item.uid || 'Erfasst';
                                const sub = payload.item.isilName || (payload.item.marker ? 'Standort: ' + payload.item.marker : '');
                                let statusBadge = '';
                                if (payload.item.dispatchState === 'error') {
                                    statusBadge = `<div class="mt-1"><span class="badge badge-xs badge-error gap-1 font-semibold" title="${payload.item.dispatchError || 'Webservice-Fehler'}">Webservice-Fehler</span></div>`;
                                } else if (payload.item.dispatchState === 'success') {
                                    statusBadge = `<div class="mt-1"><span class="badge badge-xs badge-success gap-1 font-semibold">Übermittelt</span></div>`;
                                } else if (payload.item.dispatchState === 'pending') {
                                    statusBadge = `<div class="mt-1"><span class="badge badge-xs badge-info gap-1 animate-pulse">Wird gesendet...</span></div>`;
                                } else if (payload.item.isDuplicate) {
                                    statusBadge = `<div class="mt-1"><span class="badge badge-xs badge-warning gap-1 font-semibold">Dublette</span></div>`;
                                }
                                lastCard.innerHTML = `
                                    <div class="font-mono font-bold text-sm text-primary truncate">${label}</div>
                                    <div class="text-[11px] text-base-content/60 truncate">${sub}</div>
                                    ${statusBadge}
                                `;
                            }

                            // Show or update dynamic webservice alert on dispatch error
                            if (payload.item.dispatchState === 'error' && payload.item.dispatchError) {
                                const alertContainer = document.getElementById('webservice-alert-container');
                                const alertText = document.getElementById('webservice-alert-text');
                                if (alertContainer && alertText) {
                                    const label = payload.item.itemId || payload.item.uid || 'Medium';
                                    alertText.textContent = `Webservice-Fehler (${label}): ${payload.item.dispatchError}`;
                                    alertContainer.classList.remove('hidden');
                                }
                            }
                        }

                        // Update KPI Stats Counters
                        if (payload.stats) {
                            updateStatsUI(payload.stats);
                        }
                    } catch (err) {
                        console.error("Failed to parse inventory_tag SSE message:", err);
                    }
                } else if (eventType === 'inventory_stats') {
                    try {
                        const stats = typeof rawData === 'string' ? JSON.parse(rawData) : rawData;
                        updateStatsUI(stats);
                    } catch (err) {}
                } else if (eventType === 'inventory_session') {
                    try {
                        const session = typeof rawData === 'string' ? JSON.parse(rawData) : rawData;
                        updateSessionUI(session);
                    } catch (err) {}
                }
            }

            document.body.addEventListener('htmx:sseMessage', handleSSEEvent);
            document.body.addEventListener('inventory_tag', handleSSEEvent);
            document.body.addEventListener('inventory_stats', handleSSEEvent);
            document.body.addEventListener('inventory_session', handleSSEEvent);
            window.addEventListener('htmx:sseMessage', handleSSEEvent);

            function updateStatsUI(stats) {
                if (stats.totalScans !== undefined) {
                    const el = document.getElementById('kpi-total-scans');
                    if (el) el.textContent = stats.totalScans;
                    const navBadge = document.getElementById('stats-inventory-items');
                    if (navBadge) navBadge.textContent = stats.totalScans;
                }
                if (stats.uniqueItems !== undefined) {
                    const el = document.getElementById('kpi-unique-items');
                    if (el) el.textContent = stats.uniqueItems;
                }
                if (stats.errorTags !== undefined) {
                    const el = document.getElementById('kpi-error-tags');
                    if (el) el.textContent = stats.errorTags;
                }
                if (stats.duplicateTags !== undefined) {
                    const el = document.getElementById('kpi-duplicate-tags');
                    if (el) el.textContent = stats.duplicateTags;
                }

                const tbody = document.getElementById('inventory-table-body');
                const countBadge = document.getElementById('inv-table-count');
                if (tbody && countBadge) {
                    const rows = tbody.querySelectorAll('tr:not(#inventory-empty-row)');
                    countBadge.textContent = rows.length;
                }
            }

            const markerInput = document.getElementById('inv-marker-input');
            const startBtn = document.getElementById('btn-inv-start');
            const startLabel = document.getElementById('btn-inv-start-label');

            function validateMarkerInput() {
                if (!markerInput || !startBtn) return;
                const val = markerInput.value.trim();
                const isSessionActive = startLabel && startLabel.textContent === 'Neustart';
                if (val === '') {
                    startBtn.disabled = true;
                    startBtn.title = 'Bitte Standort / Regal-Marker eingeben, um Inventur zu starten';
                } else {
                    startBtn.disabled = false;
                    startBtn.title = isSessionActive ? 'Inventur neu starten' : 'Inventur mit aktuellem Marker starten';
                }
            }

            if (markerInput) {
                markerInput.addEventListener('input', validateMarkerInput);
                markerInput.addEventListener('change', validateMarkerInput);
                markerInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const val = markerInput.value.trim();
                        if (val !== '' && startBtn && !startBtn.disabled) {
                            startBtn.click();
                        }
                    }
                });
            }

            // Initial validation on load
            validateMarkerInput();

            function updateSessionUI(session) {
                if (markerInput && session.marker !== undefined && !document.activeElement.isSameNode(markerInput)) {
                    markerInput.value = session.marker;
                }

                const statusBadge = document.getElementById('session-status-badge');
                const statusDot = document.getElementById('session-status-dot');
                const statusLabel = document.getElementById('session-status-label');
                const pauseBtn = document.getElementById('btn-inv-pause');
                const pauseLabel = document.getElementById('btn-inv-pause-label');
                const pauseIcon = document.getElementById('btn-inv-pause-icon');

                if (session.active) {
                    if (session.paused) {
                        if (statusLabel) statusLabel.textContent = 'Pausiert';
                        if (statusBadge) statusBadge.className = 'badge badge-sm badge-warning font-mono font-bold gap-1 px-2.5 py-3';
                        if (statusDot) statusDot.className = 'w-2 h-2 rounded-full bg-warning-content';
                        if (pauseBtn) pauseBtn.setAttribute('hx-post', 'inventory/resume');
                        if (pauseLabel) pauseLabel.textContent = 'Fortsetzen';
                        if (pauseIcon) pauseIcon.className = 'app-icon icon-play w-3.5 h-3.5';
                    } else {
                        if (statusLabel) statusLabel.textContent = 'Aktiv';
                        if (statusBadge) statusBadge.className = 'badge badge-sm badge-success font-mono font-bold gap-1 px-2.5 py-3';
                        if (statusDot) statusDot.className = 'w-2 h-2 rounded-full bg-success-content animate-pulse';
                        if (pauseBtn) pauseBtn.setAttribute('hx-post', 'inventory/pause');
                        if (pauseLabel) pauseLabel.textContent = 'Pausieren';
                        if (pauseIcon) pauseIcon.className = 'app-icon icon-pause w-3.5 h-3.5';
                    }
                    if (startLabel) startLabel.textContent = 'Neustart';
                    if (startBtn) startBtn.className = 'btn btn-sm btn-outline gap-1.5';
                } else {
                    if (statusLabel) statusLabel.textContent = 'Inaktiv';
                    if (statusBadge) statusBadge.className = 'badge badge-sm badge-ghost font-mono font-bold gap-1 px-2.5 py-3';
                    if (statusDot) statusDot.className = 'w-2 h-2 rounded-full bg-base-content/40';
                    if (startLabel) startLabel.textContent = 'Inventur starten';
                    if (startBtn) startBtn.className = 'btn btn-sm btn-primary shadow-sm gap-1.5';
                    if (pauseLabel) pauseLabel.textContent = 'Pausieren';
                    if (pauseBtn) pauseBtn.setAttribute('hx-post', 'inventory/pause');
                    if (pauseIcon) pauseIcon.className = 'app-icon icon-pause w-3.5 h-3.5';
                }

                validateMarkerInput();

                if (pauseBtn && window.htmx && typeof window.htmx.process === 'function') {
                    window.htmx.process(pauseBtn);
                }

                if (session.stats) {
                    updateStatsUI(session.stats);
                }

                const emptyRow = document.getElementById('inventory-empty-row');
                if (emptyRow) {
                    if (session.active) {
                        const markerText = session.marker ? ` (Standort: <span class="font-mono font-bold text-primary">${session.marker}</span>)` : '';
                        emptyRow.innerHTML = `
                            <td colspan="8" class="text-center py-12 text-base-content/50">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <span class="app-icon icon-play w-8 h-8 text-success animate-pulse" aria-hidden="true"></span>
                                    <p class="font-medium text-sm text-base-content/80">Inventursitzung aktiv${markerText}</p>
                                    <p class="text-xs text-base-content/50">Halten Sie Medien an den RFID-Leser, um die Erfassung zu starten.</p>
                                </div>
                            </td>
                        `;
                    } else {
                        emptyRow.innerHTML = `
                            <td colspan="8" class="text-center py-12 text-base-content/50">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <span class="app-icon icon-archive w-8 h-8 opacity-40" aria-hidden="true"></span>
                                    <p class="font-medium text-sm">Keine aktive Inventursitzung.</p>
                                    <p class="text-xs text-base-content/40">Geben Sie oben einen Standort/Regal-Marker ein und starten Sie die Sitzung.</p>
                                </div>
                            </td>
                        `;
                    }
                }
            }

            // Immediately update session UI on HTMX request completion
            document.body.addEventListener('htmx:afterRequest', function(evt) {
                if (evt.detail && evt.detail.elt) {
                    const id = evt.detail.elt.id;
                    if (id === 'btn-inv-start' && evt.detail.successful) {
                        updateSessionUI({ active: true, paused: false, marker: markerInput ? markerInput.value.trim() : '' });
                    } else if (id === 'btn-inv-reset' && evt.detail.successful) {
                        updateSessionUI({ active: false, paused: false, marker: markerInput ? markerInput.value.trim() : '', stats: { totalScans: 0, uniqueItems: 0, errorTags: 0, duplicateTags: 0 } });
                    }
                }
            });

            // Live Table Filter Input (F2 / Esc)
            const filterInput = document.getElementById('inv-filter-input');
            function applyFilter() {
                if (!filterInput) return;
                const query = filterInput.value.trim().toLowerCase();
                const tbody = document.getElementById('inventory-table-body');
                if (!tbody) return;

                const rows = tbody.querySelectorAll('tr:not(#inventory-empty-row)');
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(query) ? '' : 'none';
                });
            }

            if (filterInput) {
                filterInput.addEventListener('input', applyFilter);
            }

            // Keyboard Shortcuts
            window.addEventListener('keydown', function(e) {
                // F2 to focus filter input
                if (e.key === 'F2') {
                    e.preventDefault();
                    if (filterInput) {
                        filterInput.focus();
                        filterInput.select();
                    }
                }
                // Escape to clear filter input
                if (e.key === 'Escape' && document.activeElement === filterInput) {
                    filterInput.value = '';
                    applyFilter();
                    filterInput.blur();
                }
                // Alt+1 (Desk), Alt+2 (Loan), Alt+3 (Encode), Alt+4 (Inventory)
                if (e.altKey && e.key === '1') {
                    window.location.href = './';
                } else if (e.altKey && e.key === '2') {
                    window.location.href = 'loan';
                } else if (e.altKey && e.key === '3') {
                    window.location.href = 'encode';
                } else if (e.altKey && e.key === '4') {
                    window.location.href = 'inventory';
                }
            });
        })();
    </script>

    <!-- Interactive script for audio, counters, shortcuts and SSE indicator (Relative Path) -->
    <script type="module" src="{{.StaticPath}}/js/desk.js"></script>
</body>
</html>
