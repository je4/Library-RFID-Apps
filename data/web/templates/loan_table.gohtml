{{if .ErrorMessage}}
    <tr id="loan-action-error-row" class="app-loan-banner-error">
        <td colspan="8" class="py-3 px-4 font-medium text-xs">
            <div class="flex items-start space-x-2">
                <svg class="w-4 h-4 text-rose-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div class="flex-1">
                    <div><strong>Fehler beim Setzen der AFI:</strong> {{.ErrorMessage}}</div>
                    {{if .FailedItems}}
                    <ul class="mt-1 space-y-0.5 text-[11px] list-disc list-inside opacity-90">
                        {{range .FailedItems}}
                        <li>{{.}}</li>
                        {{end}}
                    </ul>
                    {{end}}
                </div>
            </div>
        </td>
    </tr>
{{end}}
{{if .SuccessMessage}}
    <tr id="loan-action-success-row" class="app-loan-banner-success">
        <td colspan="8" class="py-3 px-4 font-medium text-xs">
            <div class="flex items-center space-x-2">
                <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>{{.SuccessMessage}}</span>
            </div>
        </td>
    </tr>
{{end}}
{{if .Tags}}
    {{range .Tags}}
        {{template "loan_row.gohtml" .}}
    {{end}}
{{else}}
    <tr id="no-active-tags-row">
        <td colspan="8" class="py-12 text-center">
            <div class="flex flex-col items-center justify-center space-y-2">
                <svg class="w-10 h-10 app-empty-icon animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                <p class="text-sm font-medium app-empty-title">Keine aktiven Medien auf dem Lesefeld</p>
                <p class="text-xs app-empty-desc">Legen Sie ein oder mehrere Medien auf das Lesegerät {{if .DefaultReader}}<strong>{{.DefaultReader}}</strong>{{end}}, um Ausleihe oder Rückgabe auszuführen.</p>
            </div>
        </td>
    </tr>
{{end}}
